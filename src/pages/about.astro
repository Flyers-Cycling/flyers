---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';

const leadership = (await getCollection('leadership')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="About the Club"
  description="Flyers Cycling Club is a volunteer-run 501(c)(3) youth mountain bike club in Utah. Learn how the club works, who runs it, and how we fit around the fall NICA season."
>
  <section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">
        {siteConfig.legalEntity} · {siteConfig.nonProfitStatus}
      </p>
      <h1
        class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
      >
        Volunteer-run youth mountain biking in Utah
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
        Flyers Cycling Club exists so Utah kids can learn to ride well, race if they want to, and
        feel welcome doing it, at a cost every family can manage.
      </p>
    </div>
  </section>

  <!-- Mission & Financial Transparency -->
  <section aria-labelledby="mission-heading" class="py-14 sm:py-18">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="space-y-6 lg:col-span-7">
        <h2
          id="mission-heading"
          class="font-display text-flyers-slate-dark text-4xl leading-tight font-black tracking-wide uppercase"
        >
          How the club works
        </h2>
        <p class="text-flyers-iron text-base leading-relaxed">
          Flyers Cycling Club is run by <strong class="text-flyers-slate-dark"
            >{siteConfig.legalEntity}</strong
          >, a registered 501(c)(3) non-profit. The club brings together three programs: Flyers XC
          (started in 2020), Flyers Enduro, and Jr. Flyers.
        </p>
        <p class="text-flyers-iron text-base leading-relaxed">
          Every board member, program director, and ride leader is a volunteer. Registration ({
            siteConfig.feePhilosophy.rangeLabel
          }, depending on the program) covers each rider's club t-shirt and insurance. Sponsors and
          donors pay for the rest: coach safety training, first-aid kits, pit tents, tools, and help
          for families who need it.
        </p>
        <p class="text-flyers-iron text-base leading-relaxed">
          If cost is a barrier for your family, email <a
            href={`mailto:${siteConfig.contact.email}?subject=Help%20with%20costs`}
            class="text-flyers-red-deep font-bold underline">{siteConfig.contact.email}</a
          >. Requests are confidential.
        </p>
      </div>

      <aside
        class="border-t-flyers-red rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs lg:col-span-5"
      >
        <h2 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
          Where we ride
        </h2>
        <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
          Practices, clinics, and races happen on trails and at venues across Utah:
        </p>
        <ul class="text-flyers-slate-dark mt-4 grid grid-cols-2 gap-2.5 text-sm font-bold">
          <li class="bg-flyers-snow rounded-lg border border-neutral-200/80 px-3 py-2">
            Utah County Singletrack
          </li>
          <li class="bg-flyers-snow rounded-lg border border-neutral-200/80 px-3 py-2">
            Wasatch Foothills
          </li>
          <li class="bg-flyers-snow rounded-lg border border-neutral-200/80 px-3 py-2">
            Bike Parks &amp; Skills Zones
          </li>
          <li class="bg-flyers-snow rounded-lg border border-neutral-200/80 px-3 py-2">
            ICUP XC Race Venues
          </li>
          <li class="bg-flyers-snow rounded-lg border border-neutral-200/80 px-3 py-2">
            Utah Enduro Stages
          </li>
          <li class="bg-flyers-snow rounded-lg border border-neutral-200/80 px-3 py-2">
            Trail Workdays
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- NICA High School Partnerships & Trail Stewardship -->
  <section
    aria-labelledby="partnerships-heading"
    class="border-y border-neutral-200 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
            Working alongside school teams
          </p>
          <h2
            id="partnerships-heading"
            class="font-display text-flyers-slate-dark mt-2 text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
          >
            Built around the NICA season
          </h2>
          <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
            Many Flyers riders also race for their school team in the Utah High School Cycling
            League (NICA) each fall. We schedule our winter, spring, and summer riding around that
            season, so riders show up to fall practice fitter and more confident. Flyers riders come
            from local teams including:
          </p>
          <!-- TODO(board): confirm which of these teams are formal partners before calling any of them "partners". -->
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {
              siteConfig.nicaPartners.map((team) => (
                <li class="bg-flyers-snow rounded-xl border border-neutral-200 p-3.5">
                  <p class="text-flyers-slate-dark text-sm font-extrabold">{team.name}</p>
                  <p class="text-flyers-iron text-xs">
                    {team.school} · {team.city}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="border-t-flyers-slate bg-flyers-snow flex flex-col justify-between rounded-2xl border border-t-4 border-neutral-200 p-7"
        >
          <div>
            <p class="text-flyers-slate text-xs font-extrabold tracking-widest uppercase">
              Dig Where You Ride
            </p>
            <h2
              class="font-display text-flyers-slate-dark mt-2 text-3xl leading-tight font-black tracking-wide uppercase"
            >
              Taking care of our trails
            </h2>
            <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
              Every season, Flyers riders and parents join local trail builders to clear drains,
              trim brush, and keep our home trails in good shape for hikers, runners, and riders.
            </p>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={withBase('/schedule')}
              class="bg-flyers-slate hover:bg-flyers-slate-dark font-display inline-flex min-h-12 items-center justify-center rounded-xl px-5 py-2.5 text-sm font-extrabold tracking-wider text-white uppercase transition"
            >
              See upcoming trail days &rarr;
            </a>
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="text-flyers-slate-dark inline-flex min-h-12 items-center justify-center rounded-xl border border-neutral-300 bg-white px-4 py-2.5 text-xs font-bold transition hover:bg-white/80"
            >
              Volunteer with us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Volunteer Leadership -->
  <section aria-labelledby="leadership-heading" class="py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="leadership-heading"
        class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        Who runs Flyers
      </h2>
      <p class="text-flyers-iron mt-3 max-w-2xl text-base leading-relaxed">
        Every role below is filled by a volunteer.
      </p>
      <!-- TODO(board): replace these role cards with real names, short bios, and (adult, consented) photos. -->
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          leadership.map((leader) => (
            <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs">
              <p class="text-flyers-red-deep text-xs font-extrabold tracking-wide uppercase">
                {leader.data.programFocus}
              </p>
              <h3 class="font-display text-flyers-slate-dark mt-1.5 text-2xl font-black tracking-wide uppercase">
                {leader.data.name}
              </h3>
              <p class="text-flyers-slate text-xs font-bold">{leader.data.role}</p>
              <p class="text-flyers-iron mt-3 text-sm leading-relaxed">{leader.data.bio}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
