---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Differentiators from '../components/home/Differentiators.astro';
import ProgramCards from '../components/programs/ProgramCards.astro';
import ProgramPathwayFinder from '../components/programs/ProgramPathwayFinder.astro';
import SponsorGrid from '../components/sponsors/SponsorGrid.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';

const programs = await getCollection('programs');
const sponsors = await getCollection('sponsors');
const events = (await getCollection('events'))
  .sort((a, b) => a.data.startDate.localeCompare(b.data.startDate))
  .slice(0, 3);

const programBadgeMeta: Record<string, { label: string; style: string }> = {
  all: { label: 'Whole Club', style: 'bg-flyers-slate-dark text-white' },
  xc: { label: 'Flyers XC', style: 'bg-flyers-red text-white' },
  enduro: { label: 'Flyers Enduro', style: 'bg-flyers-slate text-white' },
  'jr-flyers': { label: 'Jr. Flyers', style: 'bg-flyers-berry text-white' },
  community: { label: 'Trail & Community', style: 'bg-flyers-gold text-flyers-slate-dark' },
};
---

<BaseLayout title={siteConfig.name}>
  <Hero />

  <Differentiators />

  <!-- 3 Unified Programs -->
  <section
    aria-labelledby="home-programs-heading"
    class="bg-flyers-snow border-t border-neutral-200 py-16 sm:py-20"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
            Programs
          </p>
          <h2
            id="home-programs-heading"
            class="font-display text-flyers-slate-dark mt-2 text-4xl leading-tight font-black tracking-wide uppercase sm:text-5xl"
          >
            Three programs, kindergarten through 12th grade
          </h2>
        </div>
        <a
          href={withBase('/programs')}
          class="text-flyers-red-deep hover:text-flyers-slate-dark text-sm font-extrabold underline transition"
        >
          Compare programs and seasons &rarr;
        </a>
      </div>

      <div class="mt-10">
        <ProgramCards programs={programs} />
      </div>
    </div>
  </section>

  <!-- Interactive Pathway Finder -->
  <section class="bg-flyers-snow pb-16 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ProgramPathwayFinder />
    </div>
  </section>

  <!-- Upcoming Key Dates & Schedule Preview -->
  <section
    aria-labelledby="home-schedule-heading"
    class="border-t border-neutral-200 bg-white py-16 sm:py-20"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
            Coming up
          </p>
          <h2
            id="home-schedule-heading"
            class="font-display text-flyers-slate-dark mt-2 text-4xl leading-tight font-black tracking-wide uppercase sm:text-5xl"
          >
            Upcoming rides, clinics, and trail days
          </h2>
        </div>
        <a
          href={withBase('/schedule')}
          class="bg-flyers-slate hover:bg-flyers-slate-dark font-display inline-flex min-h-12 items-center justify-center rounded-lg px-5 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
        >
          See the full schedule &rarr;
        </a>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          events.map((event) => {
            const badge = programBadgeMeta[event.data.program];
            return (
              <article class="bg-flyers-snow flex flex-col justify-between rounded-2xl border border-neutral-200 p-6">
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs font-bold">
                    <span class={`rounded-full px-2.5 py-0.5 font-extrabold ${badge.style}`}>
                      {badge.label}
                    </span>
                    <time datetime={event.data.startDate} class="text-flyers-iron font-extrabold">
                      {event.data.startDate}
                    </time>
                  </div>
                  <h3 class="font-display text-flyers-slate-dark mt-4 text-2xl font-black tracking-wide uppercase">
                    {event.data.title}
                  </h3>
                  <p class="text-flyers-iron mt-1 text-xs font-semibold">
                    {event.data.timeLabel} · {event.data.location}
                  </p>
                  <p class="text-flyers-iron mt-3 text-sm leading-relaxed">{event.data.summary}</p>
                </div>
                {event.data.actionUrl && event.data.actionLabel && (
                  <div class="mt-5 border-t border-neutral-200 pt-3">
                    <a
                      href={event.data.actionUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-flyers-red-deep hover:text-flyers-slate-dark text-xs font-extrabold underline transition"
                    >
                      {event.data.actionLabel} &rarr;
                    </a>
                  </div>
                )}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Club Sponsors & 501(c)(3) Support -->
  <section
    aria-labelledby="home-sponsors-heading"
    class="bg-flyers-snow border-t border-neutral-200 py-16 sm:py-20"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
          Our sponsors
        </p>
        <h2
          id="home-sponsors-heading"
          class="font-display text-flyers-slate-dark mt-2 text-4xl leading-tight font-black tracking-wide uppercase sm:text-5xl"
        >
          Thank you to the people who keep us riding
        </h2>
        <p class="text-flyers-iron mt-3 text-base leading-relaxed">
          These local businesses and families help pay for coach training, first-aid supplies,
          race-day gear, and help for families who need it.
        </p>
      </div>

      <div class="mt-10">
        <SponsorGrid sponsors={sponsors} scope="club" />
      </div>
    </div>
  </section>
</BaseLayout>
