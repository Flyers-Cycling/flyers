---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';

const events = (await getCollection('events')).sort((a, b) =>
  a.data.startDate.localeCompare(b.data.startDate),
);

const programMeta: Record<string, { label: string; badgeClass: string }> = {
  all: { label: 'All Club', badgeClass: 'bg-slate-900 text-white' },
  xc: { label: 'Flyers XC', badgeClass: 'bg-sky-50 text-sky-900 border border-sky-200' },
  enduro: {
    label: 'Flyers Enduro',
    badgeClass: 'bg-orange-50 text-orange-900 border border-orange-200',
  },
  'jr-flyers': {
    label: 'Jr. Flyers (K–6)',
    badgeClass: 'bg-emerald-50 text-emerald-900 border border-emerald-200',
  },
  community: {
    label: 'Trail & Community',
    badgeClass: 'bg-amber-50 text-amber-950 border border-amber-300',
  },
};

const categoryLabels: Record<string, string> = {
  practice: 'Practice / Ride',
  race: 'Race Support',
  clinic: 'Skills Clinic',
  'trail-work': 'Trail Stewardship',
  registration: 'Registration Window',
};
---

<BaseLayout
  title="Unified Schedule & Seasonal Events"
  description="Filterable practice windows, skills clinics, ICUP & Enduro race dates, and trail stewardship days across Flyers XC, Flyers Enduro, and Jr. Flyers."
>
  <section class="bg-slate-950 py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-extrabold tracking-widest text-amber-300 uppercase">
        Club Calendar &amp; Key Dates
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-black tracking-tight text-white sm:text-5xl">
        Unified Schedule Across All 3 Programs
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-200">
        Filter key registration windows, seasonal kickoffs, skills clinics, race support days, and
        Lake Mountain trail work across Flyers XC, Flyers Enduro, and Jr. Flyers.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Semantic <search> landmark with visible radio filter pills (<6 choices) -->
      <search class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <form id="schedule-filter-form">
          <fieldset>
            <legend class="text-xs font-extrabold tracking-wider text-slate-700 uppercase">
              Filter Events by Program
            </legend>
            <div class="mt-3 flex flex-wrap gap-2.5">
              <label
                class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2 text-xs font-extrabold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="everything"
                  checked
                  class="h-3.5 w-3.5 accent-amber-400"
                />
                <span>All Events</span>
              </label>
              <label
                class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2 text-xs font-extrabold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="xc"
                  class="h-3.5 w-3.5 accent-amber-400"
                />
                <span>Flyers XC</span>
              </label>
              <label
                class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2 text-xs font-extrabold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="enduro"
                  class="h-3.5 w-3.5 accent-amber-400"
                />
                <span>Flyers Enduro</span>
              </label>
              <label
                class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2 text-xs font-extrabold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="jr-flyers"
                  class="h-3.5 w-3.5 accent-amber-400"
                />
                <span>Jr. Flyers (K–6)</span>
              </label>
              <label
                class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2 text-xs font-extrabold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="community"
                  class="h-3.5 w-3.5 accent-amber-400"
                />
                <span>Trail &amp; Community</span>
              </label>
            </div>
          </fieldset>
        </form>
        <p
          id="schedule-filter-count"
          aria-live="polite"
          class="mt-3 text-xs font-semibold text-slate-600"
        >
          Showing all {events.length} scheduled highlights
        </p>
      </search>

      <div id="schedule-events-list" class="mt-8 space-y-4">
        {
          events.map((event) => {
            const pMeta = programMeta[event.data.program];
            return (
              <article
                data-event-program={event.data.program}
                class="schedule-event-card flex flex-col justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:flex-row sm:items-center"
              >
                <div class="space-y-2">
                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class={`rounded-full px-2.5 py-0.5 font-extrabold ${pMeta.badgeClass}`}>
                      {pMeta.label}
                    </span>
                    <span class="rounded-full bg-slate-100 px-2.5 py-0.5 font-bold text-slate-700">
                      {categoryLabels[event.data.category]}
                    </span>
                    <time datetime={event.data.startDate} class="font-bold text-slate-800">
                      {event.data.startDate}
                      {event.data.endDate ? ` – ${event.data.endDate}` : ''}
                    </time>
                  </div>

                  <h2 class="text-xl font-black text-slate-900">{event.data.title}</h2>
                  <p class="text-xs font-semibold text-slate-600">
                    {event.data.timeLabel} · {event.data.location}
                  </p>
                  <p class="max-w-3xl text-sm leading-relaxed text-slate-700">
                    {event.data.summary}
                  </p>
                </div>

                {event.data.actionUrl && event.data.actionLabel && (
                  <div class="shrink-0">
                    <a
                      href={event.data.actionUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-extrabold text-white transition hover:bg-slate-800"
                    >
                      {event.data.actionLabel} &rarr;
                    </a>
                  </div>
                )}
              </article>
            );
          })
        }
      </div>

      {
        siteConfig.integrations.googleCalendarEmbedUrl ? (
          <div class="mt-12 overflow-hidden rounded-2xl border border-slate-200 bg-white p-4">
            <h2 class="mb-4 text-lg font-black text-slate-900">Live Club Google Calendar</h2>
            <iframe
              src={siteConfig.integrations.googleCalendarEmbedUrl}
              title="Flyers Cycling Club Live Practice Calendar"
              loading="lazy"
              class="h-[540px] w-full rounded-xl border-0"
            />
          </div>
        ) : (
          <div class="mt-12 rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-700">
            <h2 class="text-base font-black text-slate-900">
              Weekly Trailhead &amp; Weather Updates
            </h2>
            <p class="mt-1 leading-relaxed">
              Registered families receive live weekly trailhead pins and Utah weather adjustments
              directly from their volunteer program directors via our team calendar and rider
              communication channels.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('schedule-filter-form') as HTMLFormElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.schedule-event-card'));
  const countEl = document.getElementById('schedule-filter-count');

  if (form) {
    form.addEventListener('change', () => {
      const selected = String(new FormData(form).get('programFilter') || 'everything');
      let visibleCount = 0;

      for (const card of cards) {
        const prog = card.dataset.eventProgram || 'all';
        const show = selected === 'everything' || prog === selected || prog === 'all';
        card.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      }

      if (countEl) {
        countEl.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'event' : 'events'}`;
      }
    });
  }
</script>
