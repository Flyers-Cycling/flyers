---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';

const events = (await getCollection('events')).sort((a, b) =>
  a.data.startDate.localeCompare(b.data.startDate),
);

const programMeta: Record<string, { label: string; badgeClass: string }> = {
  all: { label: 'All Club', badgeClass: 'bg-flyers-slate-dark text-white' },
  xc: { label: 'Flyers XC', badgeClass: 'bg-[#FDF2F2] text-[#8F1616] border border-[#F2C4C4]' },
  enduro: {
    label: 'Flyers Enduro',
    badgeClass: 'bg-[#EEF3F6] text-[#14242E] border border-[#C2D2DC]',
  },
  'jr-flyers': {
    label: 'Jr. Flyers (K–6)',
    badgeClass: 'bg-[#FCF1F4] text-[#840E23] border border-[#EFC2CC]',
  },
  community: {
    label: 'Trail & Community',
    badgeClass: 'bg-[#FFF9E6] text-[#5C4500] border border-[#E6C245]',
  },
};

const categoryLabels: Record<string, string> = {
  practice: 'Practice / Ride',
  race: 'Race Support',
  clinic: 'Skills Clinic',
  'trail-work': 'Trail Stewardship',
  registration: 'Registration Window',
};
---

<BaseLayout
  title="Unified Schedule & Seasonal Events"
  description="Filterable practice windows, skills clinics, ICUP & Enduro race dates, and trail stewardship days across Flyers XC, Flyers Enduro, and Jr. Flyers."
>
  <section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">
        Club Calendar &amp; Key Dates
      </p>
      <h1
        class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
      >
        Unified Schedule Across All 3 Programs
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
        Filter key registration windows, seasonal kickoffs, skills clinics, race support days, and
        community trail work across Flyers XC, Flyers Enduro, and Jr. Flyers.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Semantic <search> landmark with visible radio filter pills (<6 choices) -->
      <search class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-xs">
        <form id="schedule-filter-form">
          <fieldset>
            <legend class="text-flyers-slate-dark text-xs font-extrabold tracking-wider uppercase">
              Filter Events by Program
            </legend>
            <div class="mt-3 flex flex-wrap gap-2.5">
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="everything"
                  checked
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>All Events</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="xc"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Flyers XC</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="enduro"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Flyers Enduro</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="jr-flyers"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Jr. Flyers (K–6)</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-4 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="programFilter"
                  value="community"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Trail &amp; Community</span>
              </label>
            </div>
          </fieldset>
        </form>
        <p
          id="schedule-filter-count"
          aria-live="polite"
          class="text-flyers-iron mt-3 text-xs font-semibold"
        >
          Showing all {events.length} scheduled highlights
        </p>
      </search>

      <div id="schedule-events-list" class="mt-8 space-y-4">
        {
          events.map((event) => {
            const pMeta = programMeta[event.data.program];
            return (
              <article
                data-event-program={event.data.program}
                class="schedule-event-card flex flex-col justify-between gap-4 rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs sm:flex-row sm:items-center"
              >
                <div class="space-y-2">
                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class={`rounded-full px-2.5 py-0.5 font-extrabold ${pMeta.badgeClass}`}>
                      {pMeta.label}
                    </span>
                    <span class="bg-flyers-snow text-flyers-iron rounded-full border border-neutral-200 px-2.5 py-0.5 font-bold">
                      {categoryLabels[event.data.category]}
                    </span>
                    <time datetime={event.data.startDate} class="text-flyers-slate-dark font-bold">
                      {event.data.startDate}
                      {event.data.endDate ? ` – ${event.data.endDate}` : ''}
                    </time>
                  </div>

                  <h2 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase sm:text-3xl">
                    {event.data.title}
                  </h2>
                  <p class="text-flyers-iron text-xs font-semibold">
                    {event.data.timeLabel} · {event.data.location}
                  </p>
                  <p class="text-flyers-iron max-w-3xl text-sm leading-relaxed">
                    {event.data.summary}
                  </p>
                </div>

                {event.data.actionUrl && event.data.actionLabel && (
                  <div class="shrink-0">
                    <a
                      href={event.data.actionUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-12 items-center justify-center rounded-xl px-5 py-2.5 text-sm font-extrabold tracking-wider text-white uppercase transition"
                    >
                      {event.data.actionLabel} &rarr;
                    </a>
                  </div>
                )}
              </article>
            );
          })
        }
      </div>

      {
        siteConfig.integrations.googleCalendarEmbedUrl ? (
          <div class="mt-12 overflow-hidden rounded-2xl border border-neutral-200 bg-white p-4">
            <h2 class="font-display text-flyers-slate-dark mb-4 text-2xl font-black tracking-wide uppercase">
              Live Club Google Calendar
            </h2>
            <iframe
              src={siteConfig.integrations.googleCalendarEmbedUrl}
              title="Flyers Cycling Club Live Practice Calendar"
              loading="lazy"
              class="h-[540px] w-full rounded-xl border-0"
            />
          </div>
        ) : (
          <div class="text-flyers-iron mt-12 rounded-2xl border border-neutral-200 bg-white p-6 text-sm">
            <h2 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
              Weekly Trailhead &amp; Weather Updates
            </h2>
            <p class="mt-1 leading-relaxed">
              Registered families receive live weekly trailhead pins and Utah weather adjustments
              directly from their volunteer program directors via our team calendar and rider
              communication channels.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('schedule-filter-form') as HTMLFormElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.schedule-event-card'));
  const countEl = document.getElementById('schedule-filter-count');

  if (form) {
    form.addEventListener('change', () => {
      const selected = String(new FormData(form).get('programFilter') || 'everything');
      let visibleCount = 0;

      for (const card of cards) {
        const prog = card.dataset.eventProgram || 'all';
        const show = selected === 'everything' || prog === selected || prog === 'all';
        card.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      }

      if (countEl) {
        countEl.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'event' : 'events'}`;
      }
    });
  }
</script>
