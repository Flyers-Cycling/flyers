---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import { withBase } from '../../lib/urls';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Rider guides"
  description="Short guides for Flyers riders and parents: bike checks, trail manners, food and water, and race day."
>
  <PageHero eyebrow="Rider guides" title="Ride smarter">
    <p>Short how-tos for riders and parents. Read one before your next ride.</p>
  </PageHero>

  <section aria-labelledby="guides-heading" class="py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 id="guides-heading" class="sr-only">All guides</h2>
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          guides.map((guide) => (
            <li>
              <a
                href={withBase(`/learn/${guide.id.replace(/^\d+-/, '')}`)}
                class="border-t-flyers-red hover:border-flyers-slate/40 block h-full rounded-2xl border border-t-4 border-neutral-200 bg-white p-6 shadow-xs transition"
              >
                <h3 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
                  {guide.data.title}
                </h3>
                <p class="text-flyers-iron mt-2 text-sm leading-relaxed">{guide.data.summary}</p>
                <p class="text-flyers-red-deep mt-4 text-xs font-extrabold underline">
                  Read the guide &rarr;
                </p>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-flyers-iron mt-10 text-sm leading-relaxed">
        Have a question these don't answer? Ask your coach at the next ride.
      </p>
    </div>
  </section>
</BaseLayout>
