---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  // File names start with a number for ordering (01-pre-ride-check.md). The URL drops it.
  return guides.map((guide) => ({
    params: { slug: guide.id.replace(/^\d+-/, '') },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<BaseLayout title={guide.data.title} description={guide.data.summary}>
  <PageHero eyebrow="Rider guide" title={guide.data.title}>
    <p>{guide.data.summary}</p>
  </PageHero>

  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <article class="club-prose rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8">
        <Content />
      </article>
      <a
        href={withBase('/learn')}
        class="text-flyers-red-deep mt-8 inline-flex min-h-12 items-center text-sm font-extrabold underline"
      >
        &larr; All rider guides
      </a>
    </div>
  </section>
</BaseLayout>
