---
import { getCollection } from 'astro:content';
import PrintLayout from '../../layouts/PrintLayout.astro';
import { siteConfig } from '../../data/site';

const tiers = (await getCollection('tiers')).sort((a, b) => a.data.order - b.data.order);
const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
---

<PrintLayout title="2027 Sponsorship Prospectus">
  <article
    class="rounded-2xl border border-slate-300 bg-white p-8 shadow-sm print:rounded-none print:border-0 print:p-0 print:shadow-none"
  >
    <!-- Prospectus Header -->
    <div
      class="flex flex-col justify-between gap-4 border-b-2 border-slate-900 pb-6 sm:flex-row sm:items-end"
    >
      <div>
        <p class="text-xs font-extrabold tracking-widest text-sky-800 uppercase">
          501(c)(3) Youth Cycling Partnership Prospectus
        </p>
        <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900">
          {siteConfig.name}
        </h1>
        <p class="mt-1 text-sm font-semibold text-slate-700">
          Operated by {siteConfig.legalEntity} · 100% Volunteer-Led · Northwest Utah County
        </p>
      </div>
      <div class="text-left text-xs text-slate-700 sm:text-right">
        <p class="font-bold text-slate-900">{siteConfig.contact.location}</p>
        <p>{siteConfig.contact.sponsorshipEmail}</p>
        <p>Tax-Deductible 501(c)(3) Non-Profit</p>
      </div>
    </div>

    <!-- Mission & Differentiators Summary -->
    <section
      aria-labelledby="prospectus-mission"
      class="print-avoid-break mt-6 grid gap-6 sm:grid-cols-3"
    >
      <div class="sm:col-span-2">
        <h2
          id="prospectus-mission"
          class="text-base font-black tracking-tight text-slate-900 uppercase"
        >
          Why Sponsor Flyers Cycling Club?
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-700">
          Flyers Cycling Club unites three youth mountain bike programs—<strong>Flyers XC</strong>, <strong
            >Flyers Enduro (Gravity)</strong
          >, and <strong>Jr. Flyers (Grades K–6)</strong>—serving families across Eagle Mountain,
          Lehi, Saratoga Springs, Cedar Fort, and Fairfield, while supporting athletes from <strong
            >Westlake, Lehi, Cedar Valley, Skyridge, and Lone Peak</strong
          > NICA high school teams.
        </p>
        <p class="mt-2 text-sm leading-relaxed text-slate-700">
          Unlike multi-thousand-dollar private clubs, Flyers is <strong>100% volunteer-led</strong>.
          Rider registration is just <strong>$50 or $150</strong> (strictly covering t-shirt and insurance).
          Community sponsors fund safety training, race-day pit equipment, trail stewardship, and rider
          scholarships.
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs">
        <h3 class="font-extrabold tracking-wider text-slate-900 uppercase">3 Programs Served</h3>
        <ul class="mt-2.5 space-y-2 text-slate-800">
          {
            programs.map((p) => (
              <li>
                <strong>{p.data.title}:</strong> {p.data.gradesLabel} ({p.data.feeAmount} reg.)
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Tier Matrix Table -->
    <section aria-labelledby="prospectus-tiers" class="print-avoid-break mt-7">
      <h2
        id="prospectus-tiers"
        class="text-base font-black tracking-tight text-slate-900 uppercase"
      >
        Annual Sponsorship Tiers &amp; Recognition Matrix
      </h2>
      <div class="mt-3 overflow-x-auto rounded-xl border border-slate-300">
        <table class="min-w-full divide-y divide-slate-300 text-left text-xs">
          <thead class="bg-slate-900 font-extrabold text-white">
            <tr>
              <th scope="col" class="px-3 py-2.5">Tier</th>
              <th scope="col" class="px-3 py-2.5">Contribution</th>
              <th scope="col" class="px-3 py-2.5">Team Jersey Logo</th>
              <th scope="col" class="px-3 py-2.5">Pit Tent &amp; Event Signage</th>
              <th scope="col" class="px-3 py-2.5">Web &amp; Community Impact</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white text-slate-800">
            {
              tiers.map((tier) => (
                <tr class={tier.data.featured ? 'bg-amber-50/70' : ''}>
                  <th scope="row" class="px-3 py-2.5 font-extrabold text-slate-900">
                    {tier.data.name}
                  </th>
                  <td class="px-3 py-2.5 font-black text-slate-900">{tier.data.amountLabel}</td>
                  <td class="px-3 py-2.5">{tier.data.jerseyPlacement}</td>
                  <td class="px-3 py-2.5">{tier.data.tentBannerPlacement}</td>
                  <td class="px-3 py-2.5">{tier.data.digitalRecognition}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- How to Complete Sponsorship -->
    <section
      aria-labelledby="prospectus-next-steps"
      class="print-avoid-break mt-7 rounded-xl border border-slate-300 bg-slate-50 p-5"
    >
      <h2
        id="prospectus-next-steps"
        class="text-sm font-black tracking-tight text-slate-900 uppercase"
      >
        How to Partner With Us (Club-Wide or Program-Designated)
      </h2>
      <div class="mt-2 grid gap-4 text-xs text-slate-700 sm:grid-cols-2">
        <div>
          <p class="font-bold text-slate-900">1. Online Zero-Fee Giving (Zeffy)</p>
          <p class="mt-0.5">
            Contribute online with 0% platform fees and receive an automatic 501(c)(3) tax receipt
            via our Zeffy portal on <strong>/sponsors</strong>.
          </p>
        </div>
        <div>
          <p class="font-bold text-slate-900">2. Corporate Check, ACH &amp; Jersey Artwork</p>
          <p class="mt-0.5">
            Make checks payable to <strong>{siteConfig.legalEntity}</strong> and email vector logos (`.svg`
            / `.eps` / `.ai`) to <strong>{siteConfig.contact.sponsorshipEmail}</strong>. Specify
            Club-Wide, XC, Enduro, or Jr. Flyers if designating a program.
          </p>
        </div>
      </div>
    </section>
  </article>
</PrintLayout>
