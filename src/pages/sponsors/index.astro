---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TierComparison from '../../components/sponsors/TierComparison.astro';
import SponsorInquiryForm from '../../components/sponsors/SponsorInquiryForm.astro';
import SponsorGrid from '../../components/sponsors/SponsorGrid.astro';
import { siteConfig } from '../../data/site';
import { withBase } from '../../lib/urls';

const tiers = await getCollection('tiers');
const sponsors = await getCollection('sponsors');
---

<BaseLayout
  title="Sponsor or Donate"
  description="Sponsor or donate to Flyers Cycling Club, a volunteer-run 501(c)(3) youth mountain bike club in Utah. See sponsorship levels and how your support is used."
>
  <!-- Hero -->
  <section class="dark-surface flyers-banner-bg py-16 text-white sm:py-22">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span
          class="border-flyers-gold/40 bg-flyers-gold/15 text-flyers-gold inline-block rounded-full border px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase"
        >
          {siteConfig.legalEntity} · {siteConfig.nonProfitStatus}
        </span>
        <h1
          class="font-display mt-4 text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
        >
          Help local kids ride
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-white/90">
          Flyers coaches are volunteers, and registration ({siteConfig.feePhilosophy.rangeLabel})
          only covers a rider's t-shirt and insurance. Sponsors and donors pay for the rest: coach
          safety training, first-aid and repair gear, race-day tents, trail days, and help for
          families who need it.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3.5">
          <a
            href={siteConfig.integrations.zeffyDonateUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-3 text-lg font-extrabold tracking-wider text-white uppercase shadow-md transition"
          >
            Donate on Zeffy &rarr;
          </a>
          <a
            href="#sponsor-inquiry"
            class="text-flyers-slate-dark hover:bg-flyers-snow inline-flex min-h-12 items-center justify-center rounded-xl bg-white px-5 py-3 text-sm font-extrabold shadow-sm transition"
          >
            Pay by check or give gear
          </a>
          <a
            href={withBase('/sponsors/prospectus')}
            class="border-flyers-gold/65 bg-flyers-slate-dark/80 text-flyers-gold hover:bg-flyers-gold hover:text-flyers-slate-dark inline-flex min-h-12 items-center justify-center rounded-xl border px-5 py-3 text-sm font-bold transition"
          >
            Printable sponsor sheet
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact & ROI Breakdown -->
  <section
    aria-labelledby="impact-heading"
    class="border-b border-neutral-200 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-3">
        <div
          class="border-t-flyers-red bg-flyers-snow rounded-2xl border border-t-4 border-neutral-200 p-6"
        >
          <h2
            id="impact-heading"
            class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
          >
            Where your money goes
          </h2>
          <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
            No one at Flyers is paid. Your gift goes to rider safety, coach first-aid training,
            race-day equipment, and fee and gear help for families who need it.
          </p>
        </div>
        <div
          class="border-t-flyers-slate bg-flyers-snow rounded-2xl border border-t-4 border-neutral-200 p-6"
        >
          <h2
            class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
          >
            Seen on trails and at races
          </h2>
          <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
            Flyers jerseys and team tents show up on local trails, at ICUP cross-country races, and
            at Utah Enduro events, in front of riders and families from across the state.
          </p>
        </div>
        <div
          class="border-t-flyers-berry bg-flyers-snow rounded-2xl border border-t-4 border-neutral-200 p-6"
        >
          <h2
            class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
          >
            Support the whole club or one program
          </h2>
          <p class="text-flyers-iron mt-2 text-sm leading-relaxed">
            Give to the whole club, or ask for your sponsorship to go to Flyers XC, Flyers Enduro,
            or Jr. Flyers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsorship Tiers -->
  <section aria-labelledby="tiers-heading" class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
            2027 sponsorship levels
          </p>
          <h2
            id="tiers-heading"
            class="font-display text-flyers-slate-dark mt-2 text-4xl leading-tight font-black tracking-wide uppercase sm:text-5xl"
          >
            Choose a level
          </h2>
        </div>
        <a
          href={withBase('/sponsors/prospectus')}
          class="text-flyers-red-deep hover:text-flyers-slate-dark text-sm font-extrabold underline transition"
        >
          Printable sponsor sheet &rarr;
        </a>
      </div>

      <div class="mt-10">
        <TierComparison tiers={tiers} />
      </div>

      <!-- Zeffy Zero-Fee Explainer -->
      <div class="border-flyers-slate/25 mt-10 rounded-2xl border bg-[#EEF3F6] p-6 sm:p-8">
        <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
          <div class="max-w-2xl">
            <h3
              class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase"
            >
              Prefer to donate any amount?
            </h3>
            <p class="text-flyers-charcoal mt-1 text-sm leading-relaxed">
              We take online gifts through Zeffy, which doesn't charge the club fees, so your full
              gift reaches {siteConfig.legalEntity}. You'll get a receipt by email right away.
            </p>
          </div>
          <a
            href={siteConfig.integrations.zeffyDonateUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-flyers-slate hover:bg-flyers-slate-dark font-display inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl px-5 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
          >
            Donate on Zeffy &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Corporate / In-Kind Inquiry Form -->
  <section class="pb-16 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SponsorInquiryForm tiers={tiers} />
    </div>
  </section>

  <!-- Current Sponsors Directory -->
  <section
    aria-labelledby="current-sponsors-heading"
    class="border-t border-neutral-200 bg-white py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="current-sponsors-heading"
        class="font-display text-flyers-slate-dark text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        Our current sponsors
      </h2>
      <div class="mt-8">
        <SponsorGrid sponsors={sponsors} showCta={false} />
      </div>

      <h2
        id="open-spots-heading"
        class="font-display text-flyers-slate-dark mt-16 text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
      >
        Open sponsorship spots
      </h2>
      <p class="text-flyers-iron mt-2 max-w-2xl text-base leading-relaxed">
        These spots are available for 2027. Ask us about any of them.
      </p>
      <div class="mt-8">
        <SponsorGrid sponsors={sponsors} showCta={false} openSlots="only" />
      </div>
    </div>
  </section>
</BaseLayout>
