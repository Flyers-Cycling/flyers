---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TierComparison from '../../components/sponsors/TierComparison.astro';
import SponsorInquiryForm from '../../components/sponsors/SponsorInquiryForm.astro';
import SponsorGrid from '../../components/sponsors/SponsorGrid.astro';
import { siteConfig } from '../../data/site';
import { withBase } from '../../lib/urls';

const tiers = await getCollection('tiers');
const sponsors = await getCollection('sponsors');
---

<BaseLayout
  title="Become a 501(c)(3) Club Sponsor"
  description="Support affordable youth mountain biking in Northwest Utah County. 100% volunteer-led 501(c)(3) sponsorships for Flyers XC, Flyers Enduro, and Jr. Flyers."
>
  <!-- Hero -->
  <section class="bg-slate-950 py-16 text-white sm:py-22">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span
          class="inline-block rounded-full border border-amber-400/40 bg-amber-400/15 px-3.5 py-1 text-xs font-extrabold tracking-wide text-amber-300 uppercase"
        >
          100% Tax-Deductible · {siteConfig.legalEntity}
        </span>
        <h1 class="mt-4 text-4xl font-black tracking-tight text-white sm:text-5xl">
          Sponsors Keep Local Kids Riding Without High Club Fees
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-200">
          Every coach in Flyers Cycling Club is an unpaid volunteer, and rider registration (<strong
            class="text-amber-300">$50 or $150</strong
          >) strictly covers a t-shirt and insurance. Your business or family sponsorship funds the
          equipment, safety training, race-day pits, and trail stewardship that make youth mountain
          biking accessible across Eagle Mountain, Lehi, Saratoga Springs, and Cedar Valley.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3.5">
          <a
            href={siteConfig.integrations.zeffyDonateUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-amber-400 px-6 py-3 text-base font-extrabold text-slate-950 transition hover:bg-amber-300"
          >
            Give Instantly on Zeffy (0% Fees) &rarr;
          </a>
          <a
            href="#sponsor-inquiry"
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-800"
          >
            Corporate Check / In-Kind Inquiry
          </a>
          <a
            href={withBase('/sponsors/prospectus')}
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-sky-400/50 bg-sky-950/60 px-5 py-3 text-sm font-bold text-sky-200 transition hover:bg-sky-900/70 hover:text-white"
          >
            Printable 1-Page PDF Prospectus
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact & ROI Breakdown -->
  <section
    aria-labelledby="impact-heading"
    class="border-b border-slate-200 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 id="impact-heading" class="text-lg font-black text-slate-900">
            100% Volunteer Leverage
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">
            Zero dollars go to administrative or coaching salaries. Every dollar you contribute goes
            directly to youth safety, coach wilderness/first-aid training, race pit equipment, and
            rider hardship waivers.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-black text-slate-900">
            Statewide Utah Trail &amp; Race Visibility
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">
            Flyers jerseys and pit canopies travel from Eagle Mountain and Lehi singletrack to ICUP
            cross-country venues, Utah Enduro stops, and NICA communities spanning Westlake, Lehi,
            Cedar Valley, Skyridge, and Lone Peak.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-black text-slate-900">Club-Wide or Program-Specific</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">
            Support the unified 501(c)(3) club as a whole, or designate your sponsorship to
            spotlight <strong>Flyers XC</strong>, <strong>Flyers Enduro (Gravity)</strong>, or <strong
              >Jr. Flyers (K–6)</strong
            >.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsorship Tiers -->
  <section aria-labelledby="tiers-heading" class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <p class="text-xs font-extrabold tracking-widest text-sky-800 uppercase">
            2027 Partnership Levels
          </p>
          <h2
            id="tiers-heading"
            class="mt-2 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl"
          >
            Sponsorship Tiers &amp; Partner Benefits
          </h2>
        </div>
        <a
          href={withBase('/sponsors/prospectus')}
          class="text-sm font-extrabold text-sky-800 underline hover:text-sky-950"
        >
          Open Print / PDF Prospectus View &rarr;
        </a>
      </div>

      <div class="mt-10">
        <TierComparison tiers={tiers} />
      </div>

      <!-- Zeffy Zero-Fee Explainer -->
      <div class="mt-10 rounded-2xl border border-sky-200 bg-sky-50 p-6 sm:p-8">
        <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
          <div class="max-w-2xl">
            <h3 class="text-lg font-black text-sky-950">
              Individual Donations &amp; Employer Matching via Zeffy (0% Platform Fees)
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-sky-900">
              We use <strong>Zeffy</strong> for online non-profit donations so 100% of your contribution
              reaches Lake Mountain Bicycle Club without credit-card processing deductions—and you receive
              an instant 501(c)(3) tax receipt.
            </p>
          </div>
          <a
            href={siteConfig.integrations.zeffyDonateUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-xl bg-sky-900 px-5 py-2.5 text-sm font-extrabold text-white transition hover:bg-sky-950"
          >
            Make a Custom Donation on Zeffy &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Corporate / In-Kind Inquiry Form -->
  <section class="pb-16 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SponsorInquiryForm tiers={tiers} />
    </div>
  </section>

  <!-- Current Sponsors Directory -->
  <section
    aria-labelledby="current-sponsors-heading"
    class="border-t border-slate-200 bg-white py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="current-sponsors-heading"
        class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl"
      >
        Current Partners &amp; Available 2027 Feature Slots
      </h2>
      <div class="mt-8">
        <SponsorGrid sponsors={sponsors} showCta={false} />
      </div>
    </div>
  </section>
</BaseLayout>
