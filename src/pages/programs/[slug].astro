---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SponsorGrid from '../../components/sponsors/SponsorGrid.astro';
import { getProgramAccentMeta, getRegistrationStatusMeta } from '../../lib/programs';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return programs.map((program) => ({
    params: { slug: program.data.programId },
    props: { program },
  }));
}

const { program } = Astro.props;
const { data } = program;
const { Content } = await render(program);

const statusMeta = getRegistrationStatusMeta(data.registrationStatus);
const accentMeta = getProgramAccentMeta(data.accentKey);

const allSponsors = await getCollection('sponsors');
const programEvents = (await getCollection('events'))
  .filter((ev) => ev.data.program === data.programId || ev.data.program === 'all')
  .sort((a, b) => a.data.startDate.localeCompare(b.data.startDate));
---

<BaseLayout title={`${data.title} (${data.discipline})`} description={data.summary}>
  <!-- Program Hero -->
  <section class="relative overflow-hidden bg-slate-950 py-14 text-white sm:py-20">
    <div class={`absolute top-0 left-0 h-1.5 w-full ${accentMeta.topBarClass}`} aria-hidden="true">
    </div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-7">
        <nav aria-label="Breadcrumb" class="mb-4 text-xs font-semibold text-slate-300">
          <ol class="flex items-center gap-2">
            <li><a href={withBase('/')} class="hover:text-white">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={withBase('/programs')} class="hover:text-white">Programs</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white">{data.title}</li>
          </ol>
        </nav>

        <div class="flex flex-wrap items-center gap-2.5">
          <span
            class={`rounded-full border px-3 py-1 text-xs font-extrabold ${accentMeta.darkPillClass}`}
          >
            {data.discipline}
          </span>
          <span
            class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold ${statusMeta.badgeClass}`}
          >
            <span class={`h-2 w-2 rounded-full ${statusMeta.dotClass}`} aria-hidden="true"></span>
            {statusMeta.label}
          </span>
        </div>

        <h1 class="mt-4 text-4xl font-black tracking-tight text-white sm:text-5xl">
          {data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-200">{data.tagline}</p>

        <div class="mt-7 flex flex-wrap items-center gap-3.5">
          <a
            href={data.registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-amber-400 px-6 py-3 text-base font-extrabold text-slate-950 transition hover:bg-amber-300"
          >
            {statusMeta.ctaLabel} ({data.feeAmount}) &rarr;
          </a>
          <a
            href={withBase('/schedule')}
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-800"
          >
            View Practice &amp; Race Dates
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-xl">
          <img
            src={withBase(data.heroImage)}
            alt={data.heroImageAlt}
            width="800"
            height="500"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Main Program Content & Sidebar -->
  <section class="py-14 sm:py-18">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <!-- Left: Program Details -->
      <div class="space-y-10 lg:col-span-7">
        <div class="club-prose rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
          <Content />
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
          <h2 class="text-2xl font-black tracking-tight text-slate-900">
            Seasonal Practice &amp; Ride Cadence
          </h2>
          <ul class="mt-4 space-y-3">
            {
              data.practiceSchedule.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-slate-700">
                  <span
                    class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-slate-900"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
          <h2 class="text-2xl font-black tracking-tight text-slate-900">
            Who {data.title} Is Built For
          </h2>
          <ul class="mt-4 space-y-3">
            {
              data.whoItsFor.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-slate-700">
                  <span class="font-black text-emerald-700" aria-hidden="true">
                    &#10003;
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-6 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-950">
            <p class="font-extrabold">Local NICA High School Synergy</p>
            <p class="mt-1 leading-relaxed">{data.nicaSynergy}</p>
          </div>
        </div>
      </div>

      <!-- Right: At-a-Glance & Gear Checklist -->
      <aside class="space-y-6 lg:col-span-5" aria-label="Program quick facts and gear requirements">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
          <h2 class="text-lg font-black text-slate-900">{data.title} At a Glance</h2>
          <dl class="mt-4 divide-y divide-slate-100 text-sm">
            <div class="py-3">
              <dt class="text-xs font-bold tracking-wider text-slate-600 uppercase">
                Ages &amp; Grades
              </dt>
              <dd class="mt-1 font-extrabold text-slate-900">
                {data.gradesLabel} · {data.agesLabel}
              </dd>
            </div>
            <div class="py-3">
              <dt class="text-xs font-bold tracking-wider text-slate-600 uppercase">
                Active Season
              </dt>
              <dd class="mt-1 font-semibold text-slate-900">{data.seasonLabel}</dd>
            </div>
            <div class="py-3">
              <dt class="text-xs font-bold tracking-wider text-slate-600 uppercase">
                Registration Window
              </dt>
              <dd class="mt-1 font-semibold text-slate-900">{data.registrationWindowLabel}</dd>
            </div>
            <div class="py-3">
              <dt class="text-xs font-bold tracking-wider text-slate-600 uppercase">
                Registration Fee (100% Volunteer-Led)
              </dt>
              <dd class="mt-1 text-lg font-black text-slate-900">{data.feeAmount}</dd>
              <p class="mt-1 text-xs leading-relaxed text-slate-700">{data.feeIncludes}</p>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
          <h2 class="text-lg font-black text-slate-900">Required Bike &amp; Safety Gear</h2>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-700">
            {
              data.gearChecklist.map((gear) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 font-black text-slate-900" aria-hidden="true">
                    &bull;
                  </span>
                  <span>{gear}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {
          programEvents.length > 0 && (
            <div class="rounded-2xl border border-slate-200 bg-slate-900 p-6 text-white">
              <h2 class="text-lg font-black text-white">Upcoming {data.shortTitle} Dates</h2>
              <ul class="mt-4 space-y-3 text-sm">
                {programEvents.map((ev) => (
                  <li class="rounded-xl border border-slate-800 bg-slate-950/70 p-3.5">
                    <p class="text-xs font-bold text-amber-300">{ev.data.startDate}</p>
                    <p class="mt-0.5 font-extrabold text-white">{ev.data.title}</p>
                    <p class="mt-0.5 text-xs text-slate-300">{ev.data.location}</p>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <!-- Program-Designated & Club Sponsors -->
  <section
    aria-labelledby="program-sponsors-heading"
    class="border-t border-slate-200 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-extrabold tracking-widest text-sky-800 uppercase">
          Powered by Local Partners
        </p>
        <h2
          id="program-sponsors-heading"
          class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl"
        >
          Sponsors Supporting {data.title}
        </h2>
        <p class="mt-2 text-sm text-slate-700">
          Businesses and families can sponsor Flyers club-wide or designate support directly to {
            data.title
          }.
        </p>
      </div>
      <div class="mt-8">
        <SponsorGrid sponsors={allSponsors} scope={data.programId} />
      </div>
    </div>
  </section>
</BaseLayout>
