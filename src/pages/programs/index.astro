---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramCards from '../../components/programs/ProgramCards.astro';
import ProgramPathwayFinder from '../../components/programs/ProgramPathwayFinder.astro';
import { withBase } from '../../lib/urls';

const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
// Youngest program first in the comparison table.
const byAge = [...programs].sort((a, b) => b.data.order - a.data.order);
---

<BaseLayout
  title="Programs: Jr. Flyers, Flyers XC & Flyers Enduro"
  description="Compare Flyers Cycling Club's three youth mountain bike programs in Utah: Jr. Flyers (grades K–6), Flyers XC (grades 7–12), and Flyers Enduro (grades 5–12)."
>
  <section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">Programs</p>
      <h1
        class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
      >
        Find the right program for your rider
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
        Every program is coached by volunteers and welcomes beginners. Compare ages, seasons, and
        costs below, or answer two quick questions to see where your rider fits.
      </p>
    </div>
  </section>

  <section aria-labelledby="all-programs-heading" class="py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="all-programs-heading" class="sr-only">Our programs</h2>
      <ProgramCards programs={programs} />
    </div>
  </section>

  <section class="pb-14 sm:pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ProgramPathwayFinder />
    </div>
  </section>

  <!-- School teams & season comparison -->
  <section
    aria-labelledby="school-teams-heading"
    class="border-t border-neutral-200 bg-white py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
          Programs side by side
        </p>
        <h2
          id="school-teams-heading"
          class="font-display text-flyers-slate-dark mt-2 text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
        >
          Riding that fits around your school team
        </h2>
        <p class="text-flyers-iron mt-3 text-base leading-relaxed">
          Many Flyers riders also race for their school team in the Utah High School Cycling League
          (NICA) each fall. Flyers runs winter through summer, so riders never have to choose.
          Here's how the seasons line up.
        </p>
      </div>

      <div class="mt-8 overflow-x-auto rounded-2xl border border-neutral-200">
        <table class="min-w-full divide-y divide-neutral-200 text-left text-sm">
          <thead
            class="bg-flyers-slate-dark text-xs font-extrabold tracking-wider text-white uppercase"
          >
            <tr>
              <th scope="col" class="px-4 py-3.5">Program</th>
              <th scope="col" class="px-4 py-3.5">Who</th>
              <th scope="col" class="px-4 py-3.5">Season</th>
              <th scope="col" class="px-4 py-3.5">Registration</th>
              <th scope="col" class="px-4 py-3.5">Focus</th>
            </tr>
          </thead>
          <tbody class="text-flyers-charcoal divide-y divide-neutral-200 bg-white">
            {
              byAge.map((program) => (
                <tr>
                  <th scope="row" class="text-flyers-slate-dark px-4 py-3.5 font-extrabold">
                    <a href={withBase(`/programs/${program.data.programId}`)} class="underline">
                      {program.data.title}
                    </a>
                  </th>
                  <td class="px-4 py-3.5">
                    {program.data.gradesLabel} ({program.data.agesLabel})
                  </td>
                  <td class="px-4 py-3.5">{program.data.seasonLabel}</td>
                  <td class="text-flyers-red-deep px-4 py-3.5 font-extrabold">
                    {program.data.feeAmount}
                  </td>
                  <td class="px-4 py-3.5">{program.data.discipline}</td>
                </tr>
              ))
            }
            <tr class="bg-flyers-snow">
              <th scope="row" class="text-flyers-slate-dark px-4 py-3.5 font-extrabold">
                School NICA teams
              </th>
              <td class="px-4 py-3.5">Grades 7–12</td>
              <td class="px-4 py-3.5">Fall</td>
              <td class="text-flyers-iron px-4 py-3.5 font-semibold">Set by each team</td>
              <td class="px-4 py-3.5">Cross-country racing for your school</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
