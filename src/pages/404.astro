---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout title="Page Not Found (404)">
  <section class="py-20 text-center sm:py-24">
    <div class="mx-auto max-w-xl px-4 sm:px-6">
      <img
        src={withBase('/images/brand/flyers-logo-red.svg')}
        alt="Flyers Cycling Club mountain crest logo"
        width="140"
        height="96"
        class="mx-auto h-20 w-auto"
      />
      <p class="text-flyers-red-deep mt-5 text-sm font-extrabold tracking-widest uppercase">
        404 · Wrong Turn on the Trail
      </p>
      <h1
        class="font-display text-flyers-slate-dark mt-2 text-4xl font-black tracking-wide uppercase sm:text-5xl"
      >
        That Trail Marker Moved
      </h1>
      <p class="text-flyers-iron mt-4 text-base leading-relaxed">
        Looking for an older link from <code>lakemountainflyers.com</code> or <code
          >flyersxc.com</code
        >? Everything for Flyers XC, Flyers Enduro, and Jr. Flyers now lives right here.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={withBase('/')}
          class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-3 text-base font-extrabold tracking-wider text-white uppercase transition"
        >
          Back to Home
        </a>
        <a
          href={withBase('/programs')}
          class="bg-flyers-slate hover:bg-flyers-slate-dark font-display inline-flex min-h-12 items-center justify-center rounded-xl px-5 py-3 text-base font-extrabold tracking-wider text-white uppercase transition"
        >
          Explore 3 Programs
        </a>
        <a
          href={withBase('/sponsors')}
          class="text-flyers-slate-dark hover:bg-flyers-snow inline-flex min-h-12 items-center justify-center rounded-xl border border-neutral-300 bg-white px-5 py-3 text-sm font-bold transition"
        >
          Sponsorships
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
