---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { withBase } from '../lib/urls';

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);

const categoryLabels: Record<string, string> = {
  'costs-nonprofit': 'Costs & Help',
  'programs-nica': 'Programs & NICA',
  'gear-safety': 'Bikes & Safety Gear',
  'sponsorship-volunteer': 'Sponsorships & Volunteering',
};
---

<BaseLayout
  title="Parent & Rider FAQ"
  description="Answers to the questions parents and riders ask most about Flyers Cycling Club: cost, which program fits, NICA, bikes and gear, and how to help."
>
  <section class="dark-surface flyers-banner-bg py-14 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-flyers-gold text-xs font-extrabold tracking-widest uppercase">
        Parent &amp; Rider Guide
      </p>
      <h1
        class="font-display mt-3 max-w-3xl text-4xl leading-[0.98] font-black tracking-wide text-white uppercase sm:text-6xl"
      >
        Frequently Asked Questions
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">
        Answers to the questions parents and riders ask most: what it costs, which program fits, how
        Flyers works with school NICA teams, bikes and gear, and how to help.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Semantic <search> with search input + <6 category radio pills -->
      <search class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-xs">
        <form id="faq-filter-form" class="space-y-4">
          <div>
            <label for="faq-search" class="text-flyers-slate-dark block text-sm font-extrabold">
              Search Questions
            </label>
            <input
              type="search"
              id="faq-search"
              name="q"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder="e.g., NICA, helmet, $50, Enduro, tax-deductible..."
              class="bg-flyers-snow text-flyers-charcoal mt-1.5 block min-h-12 w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-base"
            />
          </div>

          <fieldset>
            <legend class="text-flyers-slate-dark text-xs font-extrabold tracking-wider uppercase">
              Filter by Topic
            </legend>
            <div class="mt-2 flex flex-wrap gap-2">
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-3.5 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="faqCategory"
                  value="all"
                  checked
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>All Topics</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-3.5 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="faqCategory"
                  value="costs-nonprofit"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Costs &amp; Help</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-3.5 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="faqCategory"
                  value="programs-nica"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Programs &amp; NICA</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-3.5 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="faqCategory"
                  value="gear-safety"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Bikes &amp; Gear</span>
              </label>
              <label
                class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-neutral-300 px-3.5 py-2 text-xs font-extrabold transition has-[:checked]:text-white"
              >
                <input
                  type="radio"
                  name="faqCategory"
                  value="sponsorship-volunteer"
                  class="accent-flyers-gold h-3.5 w-3.5"
                />
                <span>Sponsors &amp; Volunteering</span>
              </label>
            </div>
          </fieldset>
        </form>
        <p id="faq-count" aria-live="polite" class="text-flyers-iron mt-3 text-xs font-semibold">
          Showing all {faqs.length} questions
        </p>
      </search>

      <!-- Native <details name="faq"> exclusive accordions with explicit chevron cue -->
      <div class="mt-8 space-y-3">
        {
          faqs.map((faq, idx) => (
            <details
              name="faq"
              open={idx === 0}
              data-faq-category={faq.data.category}
              data-faq-text={`${faq.data.question} ${faq.data.answer}`.toLowerCase()}
              class="faq-item rounded-2xl border border-neutral-200 bg-white shadow-xs"
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 text-left">
                <div>
                  <span class="text-flyers-red-deep block text-xs font-extrabold tracking-wide uppercase">
                    {categoryLabels[faq.data.category]}
                  </span>
                  <span class="text-flyers-slate-dark mt-1 block text-base font-extrabold">
                    {faq.data.question}
                  </span>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="faq-chevron text-flyers-slate shrink-0 transition-transform duration-200"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </summary>
              <div class="text-flyers-iron border-t border-neutral-100 px-6 py-4 text-sm leading-relaxed">
                {faq.data.answer}
              </div>
            </details>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl border border-neutral-200 bg-white p-6 text-center">
        <h2 class="font-display text-flyers-slate-dark text-2xl font-black tracking-wide uppercase">
          Still Have a Question?
        </h2>
        <p class="text-flyers-iron mt-1 text-sm">
          Email our volunteer leadership team at{' '}
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="text-flyers-red-deep hover:text-flyers-slate-dark font-bold underline"
          >
            {siteConfig.contact.email}
          </a>{' '}
          or try the{' '}
          <a
            href={withBase('/programs#pathway-finder')}
            class="text-flyers-red-deep hover:text-flyers-slate-dark font-bold underline"
          >
            Interactive Program Finder
          </a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('faq-filter-form') as HTMLFormElement | null;
  const searchInput = document.getElementById('faq-search') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.faq-item'));
  const countEl = document.getElementById('faq-count');

  const applyFilter = () => {
    if (!form) return;
    const category = String(new FormData(form).get('faqCategory') || 'all');
    const query = (searchInput?.value || '').trim().toLowerCase();
    let visible = 0;

    for (const item of items) {
      const itemCat = item.dataset.faqCategory || '';
      const text = item.dataset.faqText || '';
      const matchCat = category === 'all' || itemCat === category;
      const matchQuery = !query || text.includes(query);
      const show = matchCat && matchQuery;
      item.classList.toggle('hidden', !show);
      if (show) visible += 1;
    }

    if (countEl) {
      countEl.textContent = `Showing ${visible} ${visible === 1 ? 'question' : 'questions'}`;
    }
  };

  form?.addEventListener('submit', (e) => e.preventDefault());
  form?.addEventListener('change', applyFilter);
  searchInput?.addEventListener('input', applyFilter);
</script>
