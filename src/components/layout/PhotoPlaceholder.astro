---
// A plain brand-colored block shown where a real club photo belongs.
// TODO(board): photo needed. Replace with real, media-released photos of Flyers riders.
// Never use AI-generated or stock images here (see AGENTS.md section 5).
import { withBase } from '../../lib/urls';

interface Props {
  /** Background color class, e.g. a program accent like 'bg-[#B81E1E]'. */
  tone?: string;
  class?: string;
}

const { tone = 'bg-flyers-slate', class: className = '' } = Astro.props;
---

<div
  class={`flex h-full w-full items-center justify-center ${tone} ${className}`}
  aria-hidden="true"
  data-photo-placeholder
>
  <img
    src={withBase('/images/brand/flyers-logo-white.svg')}
    alt=""
    width="310"
    height="214"
    loading="lazy"
    class="h-1/3 max-h-28 w-auto opacity-25"
  />
</div>
