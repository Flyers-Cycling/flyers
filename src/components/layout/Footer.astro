---
import { siteConfig } from '../../data/site';
import { withBase } from '../../lib/urls';
---

<footer
  class="no-print dark-surface border-flyers-red bg-flyers-slate-dark border-t-4 text-white/85"
>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Club & 501(c)(3) identity -->
      <div class="space-y-4">
        <a href={withBase('/')} class="inline-flex items-center gap-3 text-white">
          <img
            src={withBase('/images/brand/flyers-logo-dark-bg.svg')}
            alt=""
            width="86"
            height="61"
            loading="lazy"
            class="h-12 w-auto shrink-0"
          />
          <span class="sr-only">{siteConfig.name} — </span>
          <span class="font-display text-2xl font-black tracking-wider uppercase">
            Cycling Club
          </span>
        </a>
        <p class="text-sm leading-relaxed text-white/80">
          Serving youth riders and families across {siteConfig.region}. Built to make mountain
          biking fun, competitive, and genuinely affordable.
        </p>
        <div
          class="bg-flyers-slate/70 rounded-xl border border-white/15 p-3.5 text-xs leading-relaxed text-white/85"
        >
          <p class="font-bold text-white">{siteConfig.legalEntity}</p>
          <p class="mt-1">
            Registered {siteConfig.nonProfitStatus} · 100% Volunteer-Led. Rider fees (<strong
              class="text-flyers-gold">{siteConfig.feePhilosophy.rangeLabel}</strong
            >) cover t-shirt &amp; insurance only.
          </p>
        </div>
      </div>

      <!-- 3 Programs -->
      <div>
        <h2 class="text-flyers-gold font-display text-lg font-extrabold tracking-wider uppercase">
          Our 3 Programs
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={withBase('/programs/xc')} class="text-white/85 transition hover:text-white">
              Flyers XC (Grades 7–12 · Endurance)
            </a>
          </li>
          <li>
            <a
              href={withBase('/programs/enduro')}
              class="text-white/85 transition hover:text-white"
            >
              Flyers Enduro (Ages 10–19 · Gravity)
            </a>
          </li>
          <li>
            <a
              href={withBase('/programs/jr-flyers')}
              class="text-white/85 transition hover:text-white"
            >
              Jr. Flyers (Grades K–6 · Youth Skills)
            </a>
          </li>
          <li>
            <a
              href={withBase('/programs#pathway-finder')}
              class="text-flyers-gold hover:text-flyers-gold-bright font-bold transition"
            >
              Interactive Program Pathway Finder &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Club Navigation & NICA Partners -->
      <div>
        <h2 class="text-flyers-gold font-display text-lg font-extrabold tracking-wider uppercase">
          Club &amp; Community
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={withBase('/schedule')} class="text-white/85 transition hover:text-white">
              Unified Schedule &amp; Events
            </a>
          </li>
          <li>
            <a href={withBase('/store')} class="text-white/85 transition hover:text-white">
              Volt Team Kits, Shop &amp; Updates
            </a>
          </li>
          <li>
            <a href={withBase('/about')} class="text-white/85 transition hover:text-white">
              About, Coaches &amp; NICA Partners
            </a>
          </li>
          <li>
            <a href={withBase('/faq')} class="text-white/85 transition hover:text-white">
              Parent &amp; Rider FAQ
            </a>
          </li>
        </ul>
        <p class="text-flyers-silver mt-4 text-xs leading-relaxed">
          Proudly supporting athletes from Westlake, Lehi, Cedar Valley, Skyridge &amp; Lone Peak
          NICA teams.
        </p>
      </div>

      <!-- Sponsorships & Contact -->
      <div>
        <h2 class="text-flyers-gold font-display text-lg font-extrabold tracking-wider uppercase">
          Sponsorships &amp; Giving
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-white/80">
          Community sponsors keep youth mountain biking accessible across Northwest Utah County.
        </p>
        <div class="mt-4 flex flex-col gap-2.5">
          <a
            href={withBase('/sponsors')}
            class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
          >
            Become a Club Sponsor
          </a>
          <a
            href={withBase('/sponsors/prospectus')}
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-white/25 bg-white/5 px-4 py-2 text-sm font-bold text-white transition hover:bg-white/15"
          >
            Printable PDF Prospectus
          </a>
        </div>
        <ul class="mt-4 space-y-1.5 text-xs text-white/80">
          <li>
            Email:{' '}
            <a href={`mailto:${siteConfig.contact.email}`} class="underline hover:text-white">
              {siteConfig.contact.email}
            </a>
          </li>
          {
            siteConfig.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline hover:text-white"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="text-flyers-silver mt-10 flex flex-col items-start justify-between gap-3 border-t border-white/15 pt-6 text-xs sm:flex-row sm:items-center"
    >
      <p>
        &copy; {new Date().getFullYear()}
        {siteConfig.name} ({siteConfig.legalEntity}). All rights reserved.
      </p>
      <p>Unifying Lake Mountain Flyers, Flyers XC, Flyers Enduro &amp; Jr. Flyers.</p>
    </div>
  </div>
</footer>
