---
import { siteConfig } from '../../data/site';
import { withBase } from '../../lib/urls';
---

<footer class="no-print border-t border-slate-800 bg-slate-950 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Club & 501(c)(3) identity -->
      <div class="space-y-4">
        <a href={withBase('/')} class="inline-flex items-center gap-2.5 text-white">
          <span class="text-lg font-black tracking-tight uppercase">{siteConfig.name}</span>
        </a>
        <p class="text-sm leading-relaxed text-slate-300">
          Serving youth riders and families across {siteConfig.region}. Built to make mountain
          biking fun, competitive, and genuinely affordable.
        </p>
        <div
          class="rounded-xl border border-slate-800 bg-slate-900/80 p-3.5 text-xs leading-relaxed text-slate-300"
        >
          <p class="font-bold text-white">{siteConfig.legalEntity}</p>
          <p class="mt-1">
            Registered {siteConfig.nonProfitStatus} · 100% Volunteer-Led. Rider fees ({
              siteConfig.feePhilosophy.rangeLabel
            }) cover t-shirt &amp; insurance only.
          </p>
        </div>
      </div>

      <!-- 3 Programs -->
      <div>
        <h2 class="text-xs font-extrabold tracking-wider text-white uppercase">Our 3 Programs</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={withBase('/programs/xc')} class="text-slate-300 transition hover:text-sky-300">
              Flyers XC (Grades 7–12 · Endurance)
            </a>
          </li>
          <li>
            <a
              href={withBase('/programs/enduro')}
              class="text-slate-300 transition hover:text-orange-300"
            >
              Flyers Enduro (Ages 10–19 · Gravity)
            </a>
          </li>
          <li>
            <a
              href={withBase('/programs/jr-flyers')}
              class="text-slate-300 transition hover:text-emerald-300"
            >
              Jr. Flyers (Grades K–6 · Youth Skills)
            </a>
          </li>
          <li>
            <a
              href={withBase('/programs#pathway-finder')}
              class="font-semibold text-amber-300 transition hover:text-amber-200"
            >
              Interactive Program Pathway Finder &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Club Navigation & NICA Partners -->
      <div>
        <h2 class="text-xs font-extrabold tracking-wider text-white uppercase">
          Club &amp; Community
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={withBase('/schedule')} class="text-slate-300 transition hover:text-white">
              Unified Schedule &amp; Events
            </a>
          </li>
          <li>
            <a href={withBase('/store')} class="text-slate-300 transition hover:text-white">
              Volt Team Kits, Shop &amp; Updates
            </a>
          </li>
          <li>
            <a href={withBase('/about')} class="text-slate-300 transition hover:text-white">
              About, Coaches &amp; NICA Partners
            </a>
          </li>
          <li>
            <a href={withBase('/faq')} class="text-slate-300 transition hover:text-white">
              Parent &amp; Rider FAQ
            </a>
          </li>
        </ul>
        <p class="mt-4 text-xs leading-relaxed text-slate-400">
          Proudly supporting athletes from Westlake, Lehi, Cedar Valley, Skyridge &amp; Lone Peak
          NICA teams.
        </p>
      </div>

      <!-- Sponsorships & Contact -->
      <div>
        <h2 class="text-xs font-extrabold tracking-wider text-white uppercase">
          Sponsorships &amp; Giving
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-slate-300">
          Community sponsors keep youth mountain biking accessible across Northwest Utah County.
        </p>
        <div class="mt-4 flex flex-col gap-2.5">
          <a
            href={withBase('/sponsors')}
            class="inline-flex items-center justify-center rounded-lg bg-amber-400 px-4 py-2.5 text-sm font-extrabold text-slate-950 transition hover:bg-amber-300"
          >
            Become a Club Sponsor
          </a>
          <a
            href={withBase('/sponsors/prospectus')}
            class="inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800"
          >
            Printable PDF Prospectus
          </a>
        </div>
        <ul class="mt-4 space-y-1.5 text-xs text-slate-300">
          <li>
            Email:{' '}
            <a href={`mailto:${siteConfig.contact.email}`} class="underline hover:text-white">
              {siteConfig.contact.email}
            </a>
          </li>
          {
            siteConfig.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline hover:text-white"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-slate-800/90 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center"
    >
      <p>
        &copy; {new Date().getFullYear()}
        {siteConfig.name} ({siteConfig.legalEntity}). All rights reserved.
      </p>
      <p>Unifying Lake Mountain Flyers, Flyers XC, Flyers Enduro &amp; Jr. Flyers.</p>
    </div>
  </div>
</footer>
