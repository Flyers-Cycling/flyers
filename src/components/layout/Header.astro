---
import { siteConfig } from '../../data/site';
import { withBase } from '../../lib/urls';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Programs', href: withBase('/programs'), matchPrefix: '/programs' },
  { label: 'Schedule', href: withBase('/schedule'), matchPrefix: '/schedule' },
  { label: 'Sponsors', href: withBase('/sponsors'), matchPrefix: '/sponsors' },
  { label: 'Gear & News', href: withBase('/store'), matchPrefix: '/store' },
  { label: 'About', href: withBase('/about'), matchPrefix: '/about' },
  { label: 'FAQ', href: withBase('/faq'), matchPrefix: '/faq' },
];

const programQuickLinks = [
  {
    label: 'Flyers XC',
    sub: 'Grades 7–12 · Endurance',
    href: withBase('/programs/xc'),
    dot: 'bg-flyers-red-bright',
  },
  {
    label: 'Flyers Enduro',
    sub: 'Ages 10–19 · Gravity',
    href: withBase('/programs/enduro'),
    dot: 'bg-flyers-gold',
  },
  {
    label: 'Jr. Flyers',
    sub: 'Grades K–6 · Youth Skills',
    href: withBase('/programs/jr-flyers'),
    dot: 'bg-white',
  },
];

function isActive(matchPrefix: string): boolean {
  const cleanPath = currentPath.replace(import.meta.env.BASE_URL || '/', '/');
  const normalized = cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`;
  return normalized === matchPrefix || normalized.startsWith(`${matchPrefix}/`);
}
---

<header
  class="no-print dark-surface border-flyers-slate-mid bg-flyers-slate/95 sticky top-0 z-40 border-b text-white shadow-md backdrop-blur"
>
  <!-- Top Brand Accent Rule + Quick Program Bar -->
  <div class="border-flyers-red bg-flyers-slate-dark border-t-3 border-b border-b-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-1.5 text-xs sm:px-6 lg:px-8"
    >
      <p class="text-flyers-silver font-medium">
        <span class="font-bold text-white">501(c)(3) Youth Cycling Club</span> · 100% Volunteer-Led ·
        Utah
      </p>
      <div class="hidden items-center gap-5 md:flex" aria-label="Quick program links">
        {
          programQuickLinks.map((prog) => (
            <a
              href={prog.href}
              class="hover:text-flyers-gold inline-flex items-center gap-1.5 font-semibold text-white/90 transition"
            >
              <span class={`h-2 w-2 rounded-full ${prog.dot}`} aria-hidden="true" />
              <span>{prog.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href={withBase('/')} class="group flex items-center gap-3.5">
      <img
        src={withBase('/images/brand/flyers-logo-dark-bg.svg')}
        alt=""
        width="72"
        height="51"
        class="h-11 w-auto shrink-0 transition duration-200 group-hover:scale-[1.03]"
      />
      <div class="border-l border-white/20 pl-3.5">
        <span class="sr-only">{siteConfig.name} — </span>
        <span
          class="font-display block text-xl leading-none font-black tracking-wider text-white uppercase sm:text-2xl"
        >
          Cycling Club
        </span>
        <span
          class="text-flyers-silver mt-0.5 block text-[11px] font-bold tracking-wider uppercase"
        >
          XC · Enduro · Jr. Flyers
        </span>
      </div>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-1 lg:flex">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) => {
            const active = isActive(item.matchPrefix);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class={`rounded-lg px-3 py-2 text-sm font-bold tracking-wide transition ${
                    active
                      ? 'bg-flyers-slate-dark text-flyers-gold ring-1 ring-white/15'
                      : 'text-white/90 hover:bg-white/10 hover:text-white'
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2.5 sm:flex">
      <a
        href={withBase('/programs#pathway-finder')}
        class="rounded-lg border border-white/25 bg-white/5 px-3.5 py-2 text-sm font-bold text-white transition hover:border-white/50 hover:bg-white/15"
      >
        Find a Program
      </a>
      <a
        href={withBase('/sponsors')}
        class="bg-flyers-red hover:bg-flyers-red-bright font-display rounded-lg px-4 py-2 text-base font-extrabold tracking-wider text-white uppercase shadow-sm transition"
      >
        Sponsor / Donate
      </a>
    </div>

    <button
      type="button"
      id="mobile-menu-open"
      aria-haspopup="dialog"
      aria-controls="mobile-nav-dialog"
      class="bg-flyers-slate-dark inline-flex min-h-12 min-w-12 items-center justify-center rounded-lg border border-white/25 p-2.5 text-white transition hover:bg-white/10 lg:hidden"
      aria-label="Open navigation menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Native accessible light-dismiss modal drawer -->
  <dialog
    id="mobile-nav-dialog"
    closedby="any"
    aria-labelledby="mobile-nav-title"
    class="dark-surface border-flyers-slate-mid bg-flyers-slate-dark m-0 ml-auto h-dvh max-h-none w-full max-w-sm border-l p-0 text-white shadow-2xl"
  >
    <div class="flex h-full flex-col justify-between p-6">
      <div>
        <div class="flex items-center justify-between border-b border-white/15 pb-4">
          <div class="flex items-center gap-3">
            <img
              src={withBase('/images/brand/flyers-symbol-crest.svg')}
              alt=""
              width="40"
              height="22"
              fetchpriority="low"
              class="h-5 w-auto"
            />
            <h2
              id="mobile-nav-title"
              class="font-display text-xl font-black tracking-wider text-white uppercase"
            >
              Flyers Navigation
            </h2>
          </div>
          <form method="dialog">
            <button
              type="submit"
              class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-white/25 bg-white/5 px-3 py-2 text-sm font-bold text-white hover:bg-white/15"
            >
              Close
            </button>
          </form>
        </div>

        <nav aria-label="Mobile navigation" class="mt-5">
          <p class="text-flyers-gold px-2 text-xs font-extrabold tracking-widest uppercase">
            3 Club Programs
          </p>
          <ul class="mt-2 space-y-1.5">
            {
              programQuickLinks.map((prog) => (
                <li>
                  <a
                    href={prog.href}
                    class="bg-flyers-slate/80 flex items-center justify-between rounded-lg border border-white/15 px-3.5 py-3 transition hover:border-white/40"
                  >
                    <span class="flex items-center gap-2.5 font-bold text-white">
                      <span class={`h-2.5 w-2.5 rounded-full ${prog.dot}`} aria-hidden="true" />
                      {prog.label}
                    </span>
                    <span class="text-flyers-silver text-xs">{prog.sub}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="text-flyers-gold mt-6 px-2 text-xs font-extrabold tracking-widest uppercase">
            Explore Club
          </p>
          <ul class="mt-2 space-y-1">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block rounded-lg px-3 py-2.5 text-base font-bold text-white/90 transition hover:bg-white/10 hover:text-white"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="space-y-2.5 border-t border-white/15 pt-4">
        <a
          href={withBase('/programs#pathway-finder')}
          class="block w-full rounded-lg border border-white/25 bg-white/5 px-4 py-3 text-center text-sm font-bold text-white hover:bg-white/15"
        >
          Find Your Rider's Program
        </a>
        <a
          href={withBase('/sponsors')}
          class="bg-flyers-red hover:bg-flyers-red-bright font-display block w-full rounded-lg px-4 py-3 text-center text-base font-extrabold tracking-wider text-white uppercase"
        >
          Sponsor or Donate (501c3)
        </a>
      </div>
    </div>
  </dialog>
</header>

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const dialog = document.getElementById('mobile-nav-dialog') as HTMLDialogElement | null;

  if (openBtn && dialog) {
    openBtn.addEventListener('click', () => {
      dialog.showModal();
    });

    // Close drawer when following same-page hash links
    dialog.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (dialog.open) dialog.close();
      });
    });

    // Safari / cross-browser fallback for declarative <dialog closedby="any">
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;

        if (!isDialogContent) {
          dialog.close();
        }
      });
    }
  }
</script>
