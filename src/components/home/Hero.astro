---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../data/site';
import { withBase } from '../../lib/urls';

const programs = await getCollection('programs');
const byId = Object.fromEntries(programs.map((p) => [p.data.programId, p.data]));
const gradesFor = (id: 'xc' | 'enduro' | 'jr-flyers') =>
  byId[id]?.gradesLabel.replace(/^Grades/, 'grades') ?? '';
---

<section class="dark-surface bg-flyers-slate-dark relative overflow-hidden text-white">
  <!-- Golden-hour Lake Mountain & Wasatch singletrack LCP photograph -->
  <div class="pointer-events-none absolute inset-0">
    <img
      src={withBase('/images/hero-flyers.jpg')}
      alt="Youth mountain bikers in carbon-black and crimson-red Flyers kits riding Lake Mountain singletrack overlooking Utah Lake and the Wasatch Range"
      width="1600"
      height="893"
      fetchpriority="high"
      class="h-full w-full object-cover object-[68%_center]"
    />
    <!-- Authentic Brand Kit Lake Mountain Petrol Slate directional overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#14242E]/96 via-[#203746]/86 to-[#14242E]/35"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#14242E] via-transparent to-[#14242E]/40">
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-22 lg:px-8">
    <div class="max-w-3xl">
      <!-- Official Canva Brand Kit Crest + Non-Profit Badge Lockup -->
      <div class="flex flex-wrap items-center gap-5">
        <img
          src={withBase('/images/brand/flyers-logo-dark-bg.svg')}
          alt="Flyers mountain crest logo"
          width="148"
          height="104"
          class="h-20 w-auto drop-shadow-lg sm:h-24"
        />
        <div
          class="bg-flyers-slate-dark/85 inline-flex flex-wrap items-center gap-2 rounded-full border border-white/20 px-4 py-1.5 text-xs font-extrabold tracking-wider text-white uppercase backdrop-blur-xs"
        >
          <span class="bg-flyers-red h-2 w-2 rounded-full" aria-hidden="true"></span>
          <span>501(c)(3) Non-Profit</span>
          <span class="text-flyers-gold" aria-hidden="true">·</span>
          <span>Utah Youth MTB</span>
        </div>
      </div>

      <h1
        class="font-display mt-6 text-5xl leading-[0.95] font-black tracking-wide text-white uppercase sm:text-6xl lg:text-7xl"
      >
        Mountain biking for Utah kids, <span class="text-flyers-gold"
          >kindergarten through 12th grade.</span
        >
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
        Jr. Flyers is for {gradesFor('jr-flyers')}, Flyers XC is for {gradesFor('xc')}, and Flyers
        Enduro is for riders in {gradesFor('enduro')} who love to descend. Volunteer coaches, friendly
        teammates, and registration of {siteConfig.feePhilosophy.rangeLabel}. You don't need to be
        fast, and racing is optional.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href={withBase('/programs')}
          class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-12 items-center justify-center rounded-xl px-7 py-3 text-lg font-black tracking-wider text-white uppercase shadow-lg transition"
        >
          Explore programs &rarr;
        </a>
        <a
          href="#pathway-finder"
          class="text-flyers-slate-dark hover:bg-flyers-snow inline-flex min-h-12 items-center justify-center rounded-xl bg-white px-6 py-3 text-base font-extrabold shadow-md transition"
        >
          Which program fits my rider?
        </a>
        <a
          href={withBase('/sponsors')}
          class="border-flyers-gold/65 bg-flyers-slate-dark/80 text-flyers-gold hover:bg-flyers-gold hover:text-flyers-slate-dark inline-flex min-h-12 items-center justify-center rounded-xl border px-5 py-3 text-base font-extrabold backdrop-blur-xs transition"
        >
          Support the club
        </a>
      </div>
    </div>

    <!-- Quick Impact & Differentiator Metrics Strip -->
    <dl class="mt-14 grid gap-4 border-t border-white/15 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      <div
        class="border-t-flyers-red bg-flyers-slate-dark/85 rounded-xl border border-t-3 border-white/15 p-4 backdrop-blur-xs"
      >
        <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">
          3 Programs
        </dt>
        <dd class="font-display mt-1 text-2xl font-black tracking-wide text-white uppercase">
          Jr. Flyers · XC · Enduro
        </dd>
        <dd class="text-flyers-silver mt-0.5 text-xs">Grades K–12, beginners welcome</dd>
      </div>
      <div
        class="border-t-flyers-gold bg-flyers-slate-dark/85 rounded-xl border border-t-3 border-white/15 p-4 backdrop-blur-xs"
      >
        <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">
          Rider Registration
        </dt>
        <dd class="text-flyers-gold font-display mt-1 text-2xl font-black tracking-wide uppercase">
          {siteConfig.feePhilosophy.rangeLabel}
        </dd>
        <dd class="text-flyers-silver mt-0.5 text-xs">Covers a rider t-shirt and insurance</dd>
      </div>
      <div
        class="border-t-flyers-red bg-flyers-slate-dark/85 rounded-xl border border-t-3 border-white/15 p-4 backdrop-blur-xs"
      >
        <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">
          Coaches &amp; Board
        </dt>
        <dd class="font-display mt-1 text-2xl font-black tracking-wide text-white uppercase">
          100% Volunteer-Led
        </dd>
        <dd class="text-flyers-silver mt-0.5 text-xs">{siteConfig.legalEntity}, a 501(c)(3)</dd>
      </div>
      <div
        class="border-t-flyers-gold bg-flyers-slate-dark/85 rounded-xl border border-t-3 border-white/15 p-4 backdrop-blur-xs"
      >
        <dt class="text-flyers-silver text-xs font-extrabold tracking-wider uppercase">
          Fits Your School Team
        </dt>
        <dd class="font-display mt-1 text-2xl font-black tracking-wide text-white uppercase">
          Winter to Summer
        </dd>
        <dd class="text-flyers-silver mt-0.5 text-xs">Scheduled around the fall NICA season</dd>
      </div>
    </dl>
  </div>
</section>
