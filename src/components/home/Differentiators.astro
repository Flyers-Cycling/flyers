---
import { siteConfig } from '../../data/site';
import { withBase } from '../../lib/urls';
---

<section aria-labelledby="differentiators-heading" class="bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
        Why families choose Flyers
      </p>
      <h2
        id="differentiators-heading"
        class="font-display text-flyers-slate-dark mt-2 text-4xl leading-tight font-black tracking-wide uppercase sm:text-5xl"
      >
        Great coaching. Low cost. Every kid welcome.
      </h2>
      <p class="text-flyers-iron mt-4 text-lg leading-relaxed">
        Flyers is a non-profit club run by volunteers. Our goal is simple: help kids build skills,
        make friends, and love riding for life, whether this is their first trail ride or their
        hundredth race.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      <article
        class="border-t-flyers-red bg-flyers-snow flex flex-col justify-between rounded-2xl border border-t-4 border-neutral-200 p-7 shadow-xs"
      >
        <div>
          <span
            class="bg-flyers-red font-display inline-flex h-11 w-11 items-center justify-center rounded-lg text-lg font-black text-white"
          >
            01
          </span>
          <h3 class="font-display text-flyers-slate-dark mt-5 text-2xl font-black uppercase">
            Run by volunteers
          </h3>
          <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
            {siteConfig.legalEntity} is a 501(c)(3) non-profit. Our coaches, ride leaders, and board members
            all give their time, and families pitch in at races and on trail workdays.
          </p>
        </div>
        <p class="text-flyers-slate mt-6 border-t border-neutral-200 pt-4 text-xs font-extrabold">
          We give back to the trails we ride
        </p>
      </article>

      <article
        class="border-t-flyers-slate bg-flyers-snow flex flex-col justify-between rounded-2xl border border-t-4 border-neutral-200 p-7 shadow-xs"
      >
        <div>
          <span
            class="bg-flyers-slate font-display inline-flex h-11 w-11 items-center justify-center rounded-lg text-lg font-black text-white"
          >
            02
          </span>
          <h3 class="font-display text-flyers-slate-dark mt-5 text-2xl font-black uppercase">
            One club for the whole family
          </h3>
          <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
            Jr. Flyers, Flyers XC, and Flyers Enduro share one club. Siblings can ride with the same
            community as they grow, from first singletrack turns to cross-country and gravity
            racing.
          </p>
        </div>
        <p class="text-flyers-slate mt-6 border-t border-neutral-200 pt-4 text-xs font-extrabold">
          Racing is optional. Riding is the point.
        </p>
      </article>

      <article
        class="border-t-flyers-berry bg-flyers-snow flex flex-col justify-between rounded-2xl border border-t-4 border-neutral-200 p-7 shadow-xs"
      >
        <div>
          <span
            class="bg-flyers-berry font-display inline-flex h-11 w-11 items-center justify-center rounded-lg text-lg font-black text-white"
          >
            03
          </span>
          <h3 class="font-display text-flyers-slate-dark mt-5 text-2xl font-black uppercase">
            Low cost, with help if you need it
          </h3>
          <p class="text-flyers-iron mt-3 text-sm leading-relaxed">
            Registration is {siteConfig.feePhilosophy.rangeLabel}, depending on the program, and
            covers a club t-shirt and rider insurance. Local sponsors and donors help pay for coach
            training, race-day gear, and support for families who need it.
          </p>
        </div>
        <div class="mt-6 flex flex-col gap-2 border-t border-neutral-200 pt-4">
          <a
            href={`mailto:${siteConfig.contact.email}?subject=Help%20with%20costs`}
            class="text-flyers-red-deep hover:text-flyers-slate-dark inline-flex items-center gap-1.5 text-xs font-extrabold underline"
          >
            Ask about help with costs (confidential) &rarr;
          </a>
          <a
            href={withBase('/sponsors')}
            class="text-flyers-red-deep hover:text-flyers-slate-dark inline-flex items-center gap-1.5 text-xs font-extrabold underline"
          >
            How sponsorship works &rarr;
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
