---
import { matchProgramPathway } from '../../lib/pathway';
import { withBase } from '../../lib/urls';

const initialMatch = matchProgramPathway('7-8', 'endurance');

const programRoutes = {
  xc: { label: 'Explore Flyers XC', href: withBase('/programs/xc') },
  enduro: { label: 'Explore Flyers Enduro', href: withBase('/programs/enduro') },
  'jr-flyers': { label: 'Explore Jr. Flyers', href: withBase('/programs/jr-flyers') },
};
---

<section
  id="pathway-finder"
  aria-labelledby="pathway-finder-heading"
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10"
>
  <div class="max-w-3xl">
    <p class="text-xs font-extrabold tracking-widest text-sky-800 uppercase">
      Interactive Program Matcher
    </p>
    <h2
      id="pathway-finder-heading"
      class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl"
    >
      Not Sure Where Your Rider Fits? Match in 10 Seconds
    </h2>
    <p class="mt-2 text-base text-slate-700">
      Select your rider's grade/age range and riding interest to see how Flyers XC, Flyers Enduro,
      Jr. Flyers, and local NICA high school teams fit together.
    </p>
  </div>

  <form
    id="pathway-matcher-form"
    class="mt-8 grid gap-8 lg:grid-cols-12"
    data-xc-href={programRoutes.xc.href}
    data-enduro-href={programRoutes.enduro.href}
    data-jr-href={programRoutes['jr-flyers'].href}
  >
    <div class="space-y-6 lg:col-span-7">
      <!-- Radio Group 1: Age / Grade (< 6 options => visible radios per modern-web-guidance forms) -->
      <fieldset>
        <legend class="text-sm font-extrabold text-slate-900">1. Rider Grade or Age Band</legend>
        <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input type="radio" name="ageBand" value="k-6" class="h-4 w-4 accent-amber-400" />
            <span>Grades K–6 (Ages 5–11)</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input type="radio" name="ageBand" value="10-12" class="h-4 w-4 accent-amber-400" />
            <span>Ages 10–12 (Grades 5–6 Trail Ready)</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="ageBand"
              value="7-8"
              checked
              class="h-4 w-4 accent-amber-400"
            />
            <span>Grades 7–8 (Ages 12–14)</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input type="radio" name="ageBand" value="9-12" class="h-4 w-4 accent-amber-400" />
            <span>Grades 9–12 (Ages 14–19)</span>
          </label>
        </div>
      </fieldset>

      <!-- Radio Group 2: Riding Focus -->
      <fieldset>
        <legend class="text-sm font-extrabold text-slate-900">2. Primary Riding Goal</legend>
        <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="focus"
              value="fundamentals"
              class="h-4 w-4 accent-amber-400"
            />
            <span>Trail Confidence &amp; Fun Fundamentals</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="focus"
              value="endurance"
              checked
              class="h-4 w-4 accent-amber-400"
            />
            <span>Singletrack Fitness &amp; XC Racing</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input type="radio" name="focus" value="gravity" class="h-4 w-4 accent-amber-400" />
            <span>Technical Descents, Jumps &amp; Enduro</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800 transition has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="focus"
              value="nica-offseason"
              class="h-4 w-4 accent-amber-400"
            />
            <span>Pair With My Fall NICA School Team</span>
          </label>
        </div>
      </fieldset>
    </div>

    <!-- Live Recommendation Output -->
    <div
      id="pathway-result-card"
      aria-live="polite"
      class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-950 p-6 text-white lg:col-span-5"
    >
      <div>
        <span
          class="inline-block rounded-full bg-amber-400/20 px-3 py-1 text-xs font-extrabold text-amber-300 uppercase"
        >
          Best-Fit Pathway
        </span>
        <h3 id="pathway-headline" class="mt-3 text-xl font-black text-white">
          {initialMatch.headline}
        </h3>
        <p id="pathway-explanation" class="mt-3 text-sm leading-relaxed text-slate-200">
          {initialMatch.explanation}
        </p>

        <div
          class="mt-4 space-y-2 rounded-xl border border-slate-800 bg-slate-900/90 p-3.5 text-xs text-slate-200"
        >
          <p>
            <strong class="text-amber-300">Cost Transparency:</strong>{' '}
            <span id="pathway-fee">{initialMatch.feeNote}</span>
          </p>
          <p>
            <strong class="text-sky-300">NICA Alignment:</strong>{' '}
            <span id="pathway-nica">{initialMatch.nicaNote}</span>
          </p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          id="pathway-primary-cta"
          href={programRoutes[initialMatch.primaryProgram].href}
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-amber-400 px-4 py-2.5 text-sm font-extrabold text-slate-950 transition hover:bg-amber-300"
        >
          {programRoutes[initialMatch.primaryProgram].label} &rarr;
        </a>
        <a
          id="pathway-secondary-cta"
          href={initialMatch.secondaryProgram
            ? programRoutes[initialMatch.secondaryProgram].href
            : programRoutes.enduro.href}
          class={`inline-flex min-h-11 items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2 text-xs font-bold text-slate-200 transition hover:bg-slate-800 ${
            initialMatch.secondaryProgram ? '' : 'hidden'
          }`}
        >
          {
            initialMatch.secondaryProgram
              ? `Also Check ${programRoutes[initialMatch.secondaryProgram].label.replace('Explore ', '')}`
              : ''
          }
        </a>
      </div>
    </div>
  </form>
</section>

<script>
  import {
    matchProgramPathway,
    type AgeBand,
    type RidingFocus,
    type ProgramSlug,
  } from '../../lib/pathway';

  const form = document.getElementById('pathway-matcher-form') as HTMLFormElement | null;
  if (form) {
    const routes: Record<ProgramSlug, { label: string; href: string }> = {
      xc: { label: 'Explore Flyers XC', href: form.dataset.xcHref || '/programs/xc' },
      enduro: {
        label: 'Explore Flyers Enduro',
        href: form.dataset.enduroHref || '/programs/enduro',
      },
      'jr-flyers': {
        label: 'Explore Jr. Flyers',
        href: form.dataset.jrHref || '/programs/jr-flyers',
      },
    };

    const headlineEl = document.getElementById('pathway-headline');
    const explanationEl = document.getElementById('pathway-explanation');
    const feeEl = document.getElementById('pathway-fee');
    const nicaEl = document.getElementById('pathway-nica');
    const primaryCta = document.getElementById('pathway-primary-cta') as HTMLAnchorElement | null;
    const secondaryCta = document.getElementById(
      'pathway-secondary-cta',
    ) as HTMLAnchorElement | null;

    const updateRecommendation = () => {
      const data = new FormData(form);
      const ageBand = (data.get('ageBand') as AgeBand) || '7-8';
      const focus = (data.get('focus') as RidingFocus) || 'endurance';
      const match = matchProgramPathway(ageBand, focus);

      if (headlineEl) headlineEl.textContent = match.headline;
      if (explanationEl) explanationEl.textContent = match.explanation;
      if (feeEl) feeEl.textContent = match.feeNote;
      if (nicaEl) nicaEl.textContent = match.nicaNote;

      if (primaryCta) {
        primaryCta.href = routes[match.primaryProgram].href;
        primaryCta.textContent = `${routes[match.primaryProgram].label} →`;
      }

      if (secondaryCta) {
        if (match.secondaryProgram) {
          secondaryCta.href = routes[match.secondaryProgram].href;
          secondaryCta.textContent = `Also Check ${routes[match.secondaryProgram].label.replace('Explore ', '')}`;
          secondaryCta.classList.remove('hidden');
        } else {
          secondaryCta.classList.add('hidden');
        }
      }
    };

    form.addEventListener('change', updateRecommendation);
  }
</script>
