---
import { getCollection } from 'astro:content';
import { matchProgramPathway, type ProgramFees } from '../../lib/pathway';
import { withBase } from '../../lib/urls';

const programs = await getCollection('programs');
const fees = Object.fromEntries(
  programs.map((p) => [p.data.programId, p.data.feeAmount]),
) as ProgramFees;
const initialMatch = matchProgramPathway('7-8', 'endurance', fees);

const programRoutes = {
  xc: { label: 'Explore Flyers XC', href: withBase('/programs/xc') },
  enduro: { label: 'Explore Flyers Enduro', href: withBase('/programs/enduro') },
  'jr-flyers': { label: 'Explore Jr. Flyers', href: withBase('/programs/jr-flyers') },
};
---

<section
  id="pathway-finder"
  aria-labelledby="pathway-finder-heading"
  class="rounded-3xl border border-neutral-200 bg-white p-6 shadow-sm sm:p-10"
>
  <div class="max-w-3xl">
    <p class="text-flyers-red-deep text-xs font-extrabold tracking-widest uppercase">
      Program finder
    </p>
    <h2
      id="pathway-finder-heading"
      class="font-display text-flyers-slate-dark mt-2 text-3xl leading-tight font-black tracking-wide uppercase sm:text-4xl"
    >
      Which program fits your rider?
    </h2>
    <p class="text-flyers-iron mt-2 text-base">
      Pick your rider's grade and what they enjoy most. We'll suggest a good place to start.
    </p>
  </div>

  <form
    id="pathway-matcher-form"
    class="mt-8 grid gap-8 lg:grid-cols-12"
    data-xc-href={programRoutes.xc.href}
    data-enduro-href={programRoutes.enduro.href}
    data-jr-href={programRoutes['jr-flyers'].href}
    data-fees={JSON.stringify(fees)}
  >
    <div class="space-y-6 lg:col-span-7">
      <!-- Radio Group 1: Age / Grade (< 6 options => visible radios per modern-web-guidance forms) -->
      <fieldset>
        <legend class="text-flyers-slate-dark text-sm font-extrabold">
          1. Your rider's grade this school year
        </legend>
        <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input type="radio" name="ageBand" value="k-6" class="accent-flyers-gold h-4 w-4" />
            <span>Grades K–4</span>
          </label>
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input type="radio" name="ageBand" value="10-12" class="accent-flyers-gold h-4 w-4" />
            <span>Grades 5–6</span>
          </label>
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="ageBand"
              value="7-8"
              checked
              class="accent-flyers-gold h-4 w-4"
            />
            <span>Grades 7–8</span>
          </label>
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input type="radio" name="ageBand" value="9-12" class="accent-flyers-gold h-4 w-4" />
            <span>Grades 9–12</span>
          </label>
        </div>
      </fieldset>

      <!-- Radio Group 2: Riding Focus -->
      <fieldset>
        <legend class="text-flyers-slate-dark text-sm font-extrabold">
          2. What they enjoy most
        </legend>
        <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="focus"
              value="fundamentals"
              class="accent-flyers-gold h-4 w-4"
            />
            <span>Learning the basics and having fun</span>
          </label>
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="focus"
              value="endurance"
              checked
              class="accent-flyers-gold h-4 w-4"
            />
            <span>Longer rides, fitness, and XC racing</span>
          </label>
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input type="radio" name="focus" value="gravity" class="accent-flyers-gold h-4 w-4" />
            <span>Descending, jumps, and enduro</span>
          </label>
          <label
            class="bg-flyers-snow text-flyers-charcoal has-[:checked]:border-flyers-slate has-[:checked]:bg-flyers-slate flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-neutral-300 px-4 py-3 text-sm font-semibold transition has-[:checked]:text-white"
          >
            <input
              type="radio"
              name="focus"
              value="nica-offseason"
              class="accent-flyers-gold h-4 w-4"
            />
            <span>Staying sharp between NICA seasons</span>
          </label>
        </div>
      </fieldset>
    </div>

    <!-- Live Recommendation Output -->
    <div
      id="pathway-result-card"
      aria-live="polite"
      class="dark-surface flyers-banner-bg border-flyers-slate-mid flex flex-col justify-between rounded-2xl border p-6 text-white shadow-md lg:col-span-5"
    >
      <div>
        <span
          class="border-flyers-gold/40 bg-flyers-gold/20 text-flyers-gold inline-block rounded-full border px-3 py-1 text-xs font-extrabold tracking-wide uppercase"
        >
          A good place to start
        </span>
        <h3
          id="pathway-headline"
          class="font-display mt-3 text-2xl font-black tracking-wide text-white uppercase sm:text-3xl"
        >
          {initialMatch.headline}
        </h3>
        <p id="pathway-explanation" class="mt-3 text-sm leading-relaxed text-white/90">
          {initialMatch.explanation}
        </p>

        <div
          class="bg-flyers-slate-dark/80 mt-4 space-y-2 rounded-xl border border-white/15 p-3.5 text-xs text-white/90"
        >
          <p>
            <strong class="text-flyers-gold">Cost:</strong>{' '}
            <span id="pathway-fee">{initialMatch.feeNote}</span>
          </p>
          <p>
            <strong class="font-extrabold text-white">School team:</strong>{' '}
            <span id="pathway-nica">{initialMatch.nicaNote}</span>
          </p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          id="pathway-primary-cta"
          href={programRoutes[initialMatch.primaryProgram].href}
          class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-12 items-center justify-center rounded-lg px-5 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
        >
          {programRoutes[initialMatch.primaryProgram].label} &rarr;
        </a>
        <a
          id="pathway-secondary-cta"
          href={initialMatch.secondaryProgram
            ? programRoutes[initialMatch.secondaryProgram].href
            : programRoutes.enduro.href}
          class={`inline-flex min-h-12 items-center justify-center rounded-lg border border-white/25 bg-white/10 px-3.5 py-2 text-xs font-bold text-white transition hover:bg-white/20 ${
            initialMatch.secondaryProgram ? '' : 'hidden'
          }`}
        >
          {
            initialMatch.secondaryProgram
              ? `Also see ${programRoutes[initialMatch.secondaryProgram].label.replace('Explore ', '')}`
              : ''
          }
        </a>
      </div>
    </div>
  </form>
</section>

<script>
  import {
    matchProgramPathway,
    type AgeBand,
    type RidingFocus,
    type ProgramSlug,
    type ProgramFees,
  } from '../../lib/pathway';

  const form = document.getElementById('pathway-matcher-form') as HTMLFormElement | null;
  if (form) {
    const fees = JSON.parse(form.dataset.fees || '{}') as ProgramFees;
    const routes: Record<ProgramSlug, { label: string; href: string }> = {
      xc: { label: 'Explore Flyers XC', href: form.dataset.xcHref || '/programs/xc' },
      enduro: {
        label: 'Explore Flyers Enduro',
        href: form.dataset.enduroHref || '/programs/enduro',
      },
      'jr-flyers': {
        label: 'Explore Jr. Flyers',
        href: form.dataset.jrHref || '/programs/jr-flyers',
      },
    };

    const headlineEl = document.getElementById('pathway-headline');
    const explanationEl = document.getElementById('pathway-explanation');
    const feeEl = document.getElementById('pathway-fee');
    const nicaEl = document.getElementById('pathway-nica');
    const primaryCta = document.getElementById('pathway-primary-cta') as HTMLAnchorElement | null;
    const secondaryCta = document.getElementById(
      'pathway-secondary-cta',
    ) as HTMLAnchorElement | null;

    const updateRecommendation = () => {
      const data = new FormData(form);
      const ageBand = (data.get('ageBand') as AgeBand) || '7-8';
      const focus = (data.get('focus') as RidingFocus) || 'endurance';
      const match = matchProgramPathway(ageBand, focus, fees);

      if (headlineEl) headlineEl.textContent = match.headline;
      if (explanationEl) explanationEl.textContent = match.explanation;
      if (feeEl) feeEl.textContent = match.feeNote;
      if (nicaEl) nicaEl.textContent = match.nicaNote;

      if (primaryCta) {
        primaryCta.href = routes[match.primaryProgram].href;
        primaryCta.textContent = `${routes[match.primaryProgram].label} →`;
      }

      if (secondaryCta) {
        if (match.secondaryProgram) {
          secondaryCta.href = routes[match.secondaryProgram].href;
          secondaryCta.textContent = `Also see ${routes[match.secondaryProgram].label.replace('Explore ', '')}`;
          secondaryCta.classList.remove('hidden');
        } else {
          secondaryCta.classList.add('hidden');
        }
      }
    };

    form.addEventListener('change', updateRecommendation);
  }
</script>
