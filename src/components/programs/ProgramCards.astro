---
import type { CollectionEntry } from 'astro:content';
import { getProgramAccentMeta, getRegistrationStatusMeta } from '../../lib/programs';
import { withBase } from '../../lib/urls';

interface Props {
  programs: CollectionEntry<'programs'>[];
}

const { programs } = Astro.props;
const sorted = [...programs].sort((a, b) => a.data.order - b.data.order);
---

<div class="grid gap-8 lg:grid-cols-3">
  {
    sorted.map((program) => {
      const { data } = program;
      const statusMeta = getRegistrationStatusMeta(data.registrationStatus);
      const accentMeta = getProgramAccentMeta(data.accentKey);
      const programHref = withBase(`/programs/${data.programId}`);

      return (
        <article
          class={`group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm transition ${accentMeta.borderClass}`}
        >
          <div class={`h-2 w-full ${accentMeta.topBarClass}`} aria-hidden="true" />
          <div class="bg-flyers-slate-dark relative aspect-[16/9] w-full overflow-hidden">
            <img
              src={withBase(data.heroImage)}
              alt={data.heroImageAlt}
              width="1200"
              height="669"
              loading="lazy"
              class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
            />
          </div>

          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span
                  class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-extrabold ${accentMeta.badgeClass}`}
                >
                  {data.discipline}
                </span>
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-bold ${statusMeta.badgeClass}`}
                >
                  <span class={`h-2 w-2 rounded-full ${statusMeta.dotClass}`} aria-hidden="true" />
                  {statusMeta.label}
                </span>
              </div>

              <h3 class="font-display text-flyers-slate-dark mt-4 text-3xl font-black tracking-wide uppercase">
                <a href={programHref} class="hover:text-flyers-red transition hover:underline">
                  {data.title}
                </a>
              </h3>
              <p class="text-flyers-iron mt-2 text-sm leading-relaxed">{data.summary}</p>

              <dl class="bg-flyers-snow mt-5 grid grid-cols-2 gap-3 rounded-xl border border-neutral-200/80 p-3.5 text-xs">
                <div>
                  <dt class="text-flyers-iron font-bold">Rider Ages</dt>
                  <dd class="text-flyers-slate-dark mt-0.5 font-extrabold">
                    {data.gradesLabel} ({data.agesLabel})
                  </dd>
                </div>
                <div>
                  <dt class="text-flyers-iron font-bold">Program Fee</dt>
                  <dd class="text-flyers-slate-dark mt-0.5 font-extrabold">
                    {data.feeAmount}{' '}
                    <span class="text-flyers-iron font-medium">(shirt + ins.)</span>
                  </dd>
                </div>
                <div class="col-span-2 border-t border-neutral-200 pt-2">
                  <dt class="text-flyers-iron font-bold">Season</dt>
                  <dd class="text-flyers-charcoal mt-0.5 font-semibold">{data.seasonLabel}</dd>
                </div>
              </dl>
            </div>

            <div class="mt-6 flex items-center justify-between gap-3 border-t border-neutral-100 pt-4">
              <a
                href={programHref}
                class={`font-display inline-flex min-h-12 items-center justify-center rounded-lg px-4 py-2 text-base font-extrabold tracking-wider uppercase transition ${accentMeta.buttonClass}`}
              >
                Explore {data.shortTitle} &rarr;
              </a>
              <a
                href={data.registrationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-flyers-slate hover:text-flyers-red-deep text-xs font-extrabold underline transition"
              >
                {statusMeta.ctaLabel}
              </a>
            </div>
          </div>
        </article>
      );
    })
  }
</div>
