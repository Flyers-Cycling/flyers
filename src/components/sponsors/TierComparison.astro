---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tiers: CollectionEntry<'tiers'>[];
}

const { tiers } = Astro.props;
const sorted = [...tiers].sort((a, b) => a.data.order - b.data.order);
---

<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-5">
  {
    sorted.map((tier) => {
      const { data } = tier;
      return (
        <article
          class={`flex flex-col justify-between rounded-2xl border p-6 ${
            data.featured
              ? 'dark-surface flyers-banner-bg border-flyers-red border-2 text-white shadow-xl'
              : 'text-flyers-charcoal border-neutral-200 bg-white shadow-xs'
          }`}
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <span
                class={`rounded-full px-2.5 py-0.5 text-xs font-extrabold ${
                  data.featured
                    ? 'bg-flyers-gold text-flyers-slate-dark'
                    : 'bg-flyers-snow text-flyers-slate-dark border border-neutral-200'
                }`}
              >
                {data.badgeLabel}
              </span>
            </div>

            <h3
              class={`font-display mt-4 text-2xl font-black tracking-wide uppercase ${
                data.featured ? 'text-white' : 'text-flyers-slate-dark'
              }`}
            >
              {data.name}
            </h3>
            <p
              class={`font-display mt-1 text-4xl font-black ${
                data.featured ? 'text-flyers-gold' : 'text-flyers-slate-dark'
              }`}
            >
              {data.amountLabel}
              <span
                class={`font-sans text-xs font-semibold ${
                  data.featured ? 'text-flyers-silver' : 'text-flyers-iron'
                }`}
              >
                / season
              </span>
            </p>

            <p
              class={`mt-3 text-xs leading-relaxed ${
                data.featured ? 'text-white/90' : 'text-flyers-iron'
              }`}
            >
              {data.impactHeadline}
            </p>

            <dl
              class={`mt-4 space-y-2 rounded-xl border p-3 text-xs ${
                data.featured
                  ? 'bg-flyers-slate-dark/80 border-white/15 text-white/90'
                  : 'bg-flyers-snow text-flyers-iron border-neutral-200/80'
              }`}
            >
              <div>
                <dt
                  class={`font-bold ${data.featured ? 'text-flyers-gold' : 'text-flyers-slate-dark'}`}
                >
                  On jerseys
                </dt>
                <dd class="mt-0.5">{data.jerseyPlacement}</dd>
              </div>
              <div>
                <dt class={`font-bold ${data.featured ? 'text-white' : 'text-flyers-slate-dark'}`}>
                  At races and events
                </dt>
                <dd class="mt-0.5">{data.tentBannerPlacement}</dd>
              </div>
            </dl>

            <ul class="mt-4 space-y-2 text-xs">
              {data.perks.map((perk) => (
                <li class="flex items-start gap-2">
                  <span
                    aria-hidden="true"
                    class={`mt-0.5 font-black ${data.featured ? 'text-flyers-gold' : 'text-flyers-red'}`}
                  >
                    &#10003;
                  </span>
                  <span class={data.featured ? 'text-white/90' : 'text-flyers-iron'}>{perk}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 space-y-2 pt-4">
            <a
              href={data.zeffyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`font-display flex min-h-12 w-full items-center justify-center rounded-lg px-4 py-2.5 text-center text-sm font-extrabold tracking-wider uppercase transition ${
                data.featured
                  ? 'bg-flyers-red hover:bg-flyers-red-bright text-white'
                  : 'bg-flyers-slate hover:bg-flyers-slate-dark text-white'
              }`}
            >
              Give {data.amountLabel} on Zeffy
            </a>
            <a
              href="#sponsor-inquiry"
              data-select-tier={data.name}
              class={`sponsor-tier-select-btn flex min-h-11 w-full items-center justify-center rounded-lg border px-3 py-2 text-center text-xs font-bold transition ${
                data.featured
                  ? 'border-white/25 bg-white/10 text-white hover:bg-white/20'
                  : 'text-flyers-slate-dark hover:bg-flyers-snow border-neutral-300 bg-white'
              }`}
            >
              Pay by check or give gear
            </a>
          </div>
        </article>
      );
    })
  }
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.sponsor-tier-select-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tierName = btn.dataset.selectTier;
      if (!tierName) return;
      const radio = document.querySelector<HTMLInputElement>(
        `input[name="tier"][value="${CSS.escape(tierName)}"]`,
      );
      if (radio) {
        radio.checked = true;
      }
    });
  });
</script>
