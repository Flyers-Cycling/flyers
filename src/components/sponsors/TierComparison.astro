---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tiers: CollectionEntry<'tiers'>[];
}

const { tiers } = Astro.props;
const sorted = [...tiers].sort((a, b) => a.data.order - b.data.order);
---

<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-5">
  {
    sorted.map((tier) => {
      const { data } = tier;
      return (
        <article
          class={`flex flex-col justify-between rounded-2xl border p-6 shadow-xs ${
            data.featured
              ? 'border-2 border-slate-900 bg-slate-950 text-white shadow-lg'
              : 'border-slate-200 bg-white text-slate-900'
          }`}
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <span
                class={`rounded-full px-2.5 py-0.5 text-xs font-extrabold ${
                  data.featured
                    ? 'bg-amber-400 text-slate-950'
                    : 'border border-slate-200 bg-slate-100 text-slate-800'
                }`}
              >
                {data.badgeLabel}
              </span>
            </div>

            <h3
              class={`mt-4 text-lg font-extrabold ${data.featured ? 'text-white' : 'text-slate-900'}`}
            >
              {data.name}
            </h3>
            <p
              class={`mt-1 text-3xl font-black ${data.featured ? 'text-amber-300' : 'text-slate-900'}`}
            >
              {data.amountLabel}
              <span
                class={`text-xs font-semibold ${data.featured ? 'text-slate-300' : 'text-slate-600'}`}
              >
                / season
              </span>
            </p>

            <p
              class={`mt-3 text-xs leading-relaxed ${data.featured ? 'text-slate-200' : 'text-slate-700'}`}
            >
              {data.impactHeadline}
            </p>

            <dl
              class={`mt-4 space-y-2 rounded-xl p-3 text-xs ${
                data.featured ? 'bg-slate-900 text-slate-200' : 'bg-slate-50 text-slate-700'
              }`}
            >
              <div>
                <dt class={`font-bold ${data.featured ? 'text-amber-300' : 'text-slate-900'}`}>
                  Jersey Placement
                </dt>
                <dd class="mt-0.5">{data.jerseyPlacement}</dd>
              </div>
              <div>
                <dt class={`font-bold ${data.featured ? 'text-sky-300' : 'text-slate-900'}`}>
                  Race Tent &amp; Signage
                </dt>
                <dd class="mt-0.5">{data.tentBannerPlacement}</dd>
              </div>
            </dl>

            <ul class="mt-4 space-y-2 text-xs">
              {data.perks.map((perk) => (
                <li class="flex items-start gap-2">
                  <span
                    aria-hidden="true"
                    class={`mt-0.5 font-black ${data.featured ? 'text-amber-300' : 'text-emerald-700'}`}
                  >
                    &#10003;
                  </span>
                  <span class={data.featured ? 'text-slate-200' : 'text-slate-700'}>{perk}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 space-y-2 pt-4">
            <a
              href={data.zeffyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`flex min-h-11 w-full items-center justify-center rounded-lg px-4 py-2.5 text-center text-xs font-extrabold transition ${
                data.featured
                  ? 'bg-amber-400 text-slate-950 hover:bg-amber-300'
                  : 'bg-slate-900 text-white hover:bg-slate-800'
              }`}
            >
              Fund {data.amountLabel} on Zeffy (0% Fee)
            </a>
            <a
              href="#sponsor-inquiry"
              data-select-tier={data.name}
              class={`sponsor-tier-select-btn flex min-h-10 w-full items-center justify-center rounded-lg border px-3 py-2 text-center text-xs font-bold transition ${
                data.featured
                  ? 'border-slate-700 bg-slate-900 text-slate-200 hover:bg-slate-800'
                  : 'border-slate-300 bg-white text-slate-800 hover:bg-slate-50'
              }`}
            >
              Pay by Check / In-Kind Inquiry
            </a>
          </div>
        </article>
      );
    })
  }
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.sponsor-tier-select-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tierName = btn.dataset.selectTier;
      if (!tierName) return;
      const radio = document.querySelector<HTMLInputElement>(
        `input[name="tier"][value="${CSS.escape(tierName)}"]`,
      );
      if (radio) {
        radio.checked = true;
      }
    });
  });
</script>
