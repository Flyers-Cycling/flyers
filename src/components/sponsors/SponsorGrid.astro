---
import type { CollectionEntry } from 'astro:content';
import { filterSponsorsByScope, type SponsorScope } from '../../lib/sponsors';
import { withBase } from '../../lib/urls';

interface Props {
  sponsors: CollectionEntry<'sponsors'>[];
  scope?: SponsorScope;
  showCta?: boolean;
  /** 'only' lists open sponsorship spots instead of real sponsors. */
  openSlots?: 'exclude' | 'only';
}

const { sponsors, scope, showCta = true, openSlots = 'exclude' } = Astro.props;
const inquiryHref = withBase('/sponsors#sponsor-inquiry');

const records = sponsors.map((entry) => ({
  id: entry.id,
  ...entry.data,
}));

const filtered = filterSponsorsByScope(records, scope, openSlots);

const tierBadgeLabels: Record<string, { label: string; style: string }> = {
  title: { label: 'Title Partner', style: 'bg-[#FFF9E6] text-[#5C4500] border-[#E6C245]' },
  gold: { label: 'Gold Partner', style: 'bg-[#FDF2F2] text-[#8F1616] border-[#F2C4C4]' },
  silver: { label: 'Silver Partner', style: 'bg-[#EEF3F6] text-[#14242E] border-[#C2D2DC]' },
  bronze: { label: 'Bronze Partner', style: 'bg-neutral-100 text-neutral-800 border-neutral-300' },
  community: {
    label: 'Community Supporter',
    style: 'bg-[#FCF1F4] text-[#840E23] border-[#EFC2CC]',
  },
};

const scopeLabels: Record<SponsorScope, string> = {
  club: 'Club-Wide',
  xc: 'Flyers XC',
  enduro: 'Flyers Enduro',
  'jr-flyers': 'Jr. Flyers',
};
---

<div class="space-y-8">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      filtered.map((sponsor) => {
        const badge = sponsor.openSlot
          ? {
              label: `Open · ${tierBadgeLabels[sponsor.tier].label}`,
              style: 'bg-white text-flyers-slate-dark border-dashed border-flyers-slate/50',
            }
          : tierBadgeLabels[sponsor.tier];
        const linkHref = sponsor.openSlot ? inquiryHref : sponsor.websiteUrl;
        const external = !sponsor.openSlot;
        return (
          <article class="hover:border-flyers-slate/40 flex flex-col justify-between rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs transition">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span
                  class={`rounded-full border px-2.5 py-0.5 text-xs font-extrabold ${badge.style}`}
                >
                  {badge.label}
                </span>
                {sponsor.location && (
                  <span class="text-flyers-iron text-xs font-semibold">{sponsor.location}</span>
                )}
              </div>

              <div class="bg-flyers-snow mt-4 flex h-20 items-center justify-center rounded-xl border border-neutral-200/70 p-2">
                <img
                  src={withBase(sponsor.logo)}
                  alt={`${sponsor.name} logo`}
                  width="240"
                  height="80"
                  loading="lazy"
                  class="max-h-16 w-auto object-contain"
                />
              </div>

              <h3 class="font-display text-flyers-slate-dark mt-4 text-2xl font-black tracking-wide uppercase">
                <a
                  href={linkHref}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  class="hover:text-flyers-red transition hover:underline"
                >
                  {sponsor.name}
                </a>
              </h3>
              <p class="text-flyers-iron mt-2 text-sm leading-relaxed">{sponsor.summary}</p>
            </div>

            <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-neutral-100 pt-3.5">
              <div class="flex flex-wrap gap-1.5" aria-label="Supported programs">
                {sponsor.scopes.map((s) => (
                  <span class="bg-flyers-snow text-flyers-slate-dark rounded border border-neutral-200 px-2 py-0.5 text-[11px] font-bold">
                    {scopeLabels[s]}
                  </span>
                ))}
              </div>
              <a
                href={linkHref}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="text-flyers-red-deep hover:text-flyers-slate-dark text-xs font-extrabold underline transition"
              >
                {sponsor.openSlot ? 'Ask about this spot' : 'Visit sponsor'} &rarr;
              </a>
            </div>
          </article>
        );
      })
    }
  </div>

  {
    showCta && (
      <div class="dark-surface flyers-banner-bg border-flyers-slate-mid flex flex-col items-start justify-between gap-4 rounded-2xl border p-6 text-white shadow-md sm:flex-row sm:items-center sm:p-8">
        <div>
          <h3 class="font-display text-2xl font-black tracking-wide text-white uppercase sm:text-3xl">
            Want to help local kids ride?
          </h3>
          <p class="mt-1 text-sm text-white/90">
            Sponsorships and donations of any size go straight to coaching, safety gear, race days,
            and help for families who need it.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a
            href={withBase('/sponsors')}
            class="bg-flyers-red hover:bg-flyers-red-bright font-display inline-flex min-h-12 items-center justify-center rounded-lg px-5 py-2.5 text-base font-extrabold tracking-wider text-white uppercase transition"
          >
            See sponsorship levels
          </a>
          <a
            href={withBase('/sponsors/prospectus')}
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/25 bg-white/10 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-white/20"
          >
            Printable sponsor sheet
          </a>
        </div>
      </div>
    )
  }
</div>
